-- GAMMA compatibility bootstrap for the pinned NetAnomaly protocol v3 build.
-- This module deliberately has no on_game_start: axr_main calls install once.
local installed = false
local role = nil
local server_start_pending = true

function get_role()
    if role then return role end
    local ini = ini_file("gamma_net_role.ltx")
    role = ini:r_string("network", "role")
    assert(role == "server" or role == "client", "Invalid GAMMA NetAnomaly role")
    return role
end

function is_server()
    return get_role() == "server"
end

function admin_allowed()
    return type(gamma_admin_allowed) == "function" and gamma_admin_allowed() or false
end

function request_admin(command)
    if not admin_allowed() or is_server() then return false end
    return gamma_send_admin_request(command)
end

function before_save(flags)
    flags.ret = true
    unavailable()
end

function unavailable()
    printf("[GAMMA NetAnomaly] Single-player save/load/new game is disabled in multiplayer.")
end

function server_actor_first_update(binder, delta)
    if not is_server() or not server_start_pending then return end
    server_start_pending = false
    local state = alife_storage_manager.get_state()
    if state.gamma_net_start_location_applied then return end
    state.gamma_net_start_location_applied = true
    local starts = ini_file("plugins\\new_game_start_locations.ltx")
    local section = "hidden_base"
    local position = vector():set(starts:r_float_ex(section, "x"), starts:r_float_ex(section, "y"), starts:r_float_ex(section, "z"))
    printf("[GAMMA NetAnomaly] moving server authority to k00_marsh/%s", section)
    ChangeLevel(position, starts:r_float_ex(section, "lvid"), starts:r_float_ex(section, "gvid"), VEC_ZERO)
end

function install()
    if installed then return end
    get_role() -- Fail explicitly if the wrong addon/profile was mounted.
    installed = true
    RegisterScriptCallback("on_before_save_input", before_save)
    if is_server() then
        RegisterScriptCallback("actor_on_first_update", server_actor_first_update)
    end
    printf("[GAMMA NetAnomaly] role=%s protocol=3; experimental compatibility profile", role)
end
