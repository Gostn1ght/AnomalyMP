-- Lost Zone: reuse the real GAMMA weight update and add rucksack cells beside it.
local installed = false

function update(self)
    if not level or not level.netcoop_inventory_slots or not self.player_dialog then return end
    local raw = level.netcoop_inventory_slots()
    local used, capacity = string.match(raw or "", "^(%d+)|(%d+)$")
    used, capacity = tonumber(used), tonumber(capacity)
    if not used or not capacity or capacity < 1 or capacity > 512 then return end
    if not self.lz_inventory_cells then
        local xml = CScriptXmlInit()
        xml:ParseFile("ui_inventory.xml")
        self.lz_inventory_cells = xml:InitTextWnd("player:slots", self.player_dialog)
    end
    if self.player_weight_cap then self.player_weight_cap:Show(false) end
    self.lz_inventory_cells:SetText(game.translate_string("lz_inventory_cells") .. " " .. used .. "/" .. capacity)
    self.lz_inventory_cells:SetTextColor(GetARGB(255, used > capacity and 220 or 160, used > capacity and 90 or 170, used > capacity and 70 or 180))
end

function install()
    if installed then return true end
    if not ui_inventory or not ui_inventory.UIInventory or not ui_inventory.UIInventory.UpdateWeight then return false end
    local original = ui_inventory.UIInventory.UpdateWeight
    ui_inventory.UIInventory.UpdateWeight = function(self, ...)
        original(self, ...)
        update(self)
    end
    installed = true
    return true
end

function on_game_start()
    if not install() and AddUniqueCall then AddUniqueCall(install) end
end
