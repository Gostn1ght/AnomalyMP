; NetAnomaly RP animations (player emotes).
; The motions are stock stalker animations that GAMMA already ships.
;
; [rp_list]    order of the menu; each name has its own [rp_<name>] section.
; in / mid / out  motion chains: "in" plays once, "mid" repeats while
;                 loop = true, "out" plays once when the explicit exit button is used or
;                 picks another animation.
; title        string id of the menu name (configs\text\*\st_netcoop.xml).

[rp_list]
hands_pockets
salute
greet
refuse
hands_behind
look_around
listen
hands_up
guard
sit_1
sit_2
sit_3
sleep
pushups
bar_1
bar_2
bar_3
bar_4
bar_5
bar_6
trance_1
trance_2
wounded_1
wounded_2
prisoner
psy
gop_stop
loot

