<?xml version="1.0" encoding="windows-1251"?>
<!-- Lost Zone: barter between players (netcoop_barter_client). Laid out as
     the trader's window (owner 2026-10-24, spec 9): the two offers on top,
     my backpack on the left, the partner's on the right. -->
<w>
	<barter>
		<background x="32" y="34" width="960" height="700" stretch="1">
			<texture>ui_loot_window</texture>
		</background>
		<caption x="20" y="12" width="920" height="30">
			<text font="letterica18" align="c" r="235" g="230" b="220"/>
		</caption>

		<title_give x="20" y="48" width="450" height="22">
			<text font="letterica16" align="l" r="200" g="190" b="170"/>
		</title_give>
		<cont_give x="20" y="72" width="450" height="190" stretch="1"/>
		<money_label x="20" y="268" width="200" height="24">
			<text font="letterica16" align="l" r="200" g="190" b="170"/>
		</money_label>
		<money_edit x="220" y="268" width="130" height="24" numonly="1">
			<texture>ui_inGame2_edit_box_1</texture>
			<text font="letterica16" align="r" r="235" g="230" b="220"/>
		</money_edit>
		<status_mine x="20" y="296" width="450" height="22">
			<text font="letterica16" align="l" r="235" g="230" b="220"/>
		</status_mine>

		<title_get x="490" y="48" width="450" height="22">
			<text font="letterica16" align="l" r="200" g="190" b="170"/>
		</title_get>
		<cont_get x="490" y="72" width="450" height="190" stretch="1"/>
		<their_money x="490" y="268" width="450" height="24">
			<text font="letterica16" align="l" r="200" g="190" b="170"/>
		</their_money>
		<status_theirs x="490" y="296" width="450" height="22">
			<text font="letterica16" align="l" r="235" g="230" b="220"/>
		</status_theirs>

		<title_bag x="20" y="326" width="450" height="22">
			<text font="letterica16" align="l" r="200" g="190" b="170"/>
		</title_bag>
		<cont_bag x="20" y="350" width="450" height="290" stretch="1"/>

		<title_their_bag x="490" y="326" width="450" height="22">
			<text font="letterica16" align="l" r="200" g="190" b="170"/>
		</title_their_bag>
		<cont_their_bag x="490" y="350" width="450" height="290" stretch="1"/>

		<btn_ready x="334" y="656" width="136" height="25">
			<text font="letterica16" y="2">st_netcoop_barter_ready</text>
			<texture>ui_button_ordinary</texture>
		</btn_ready>
		<btn_cancel x="490" y="656" width="136" height="25">
			<text font="letterica16" y="2">st_netcoop_barter_cancel</text>
			<texture>ui_button_ordinary</texture>
		</btn_cancel>
	</barter>

	<!-- The incoming request: Accept / Decline, 60 s. -->
	<barter_request>
		<background x="312" y="250" width="400" height="150" stretch="1">
			<texture>ui_loot_window</texture>
		</background>
		<text x="20" y="22" width="360" height="50" complex_mode="1">
			<text font="letterica18" align="c" r="235" g="230" b="220"/>
		</text>
		<time_left x="20" y="74" width="360" height="22">
			<text font="letterica16" align="c" r="200" g="190" b="170"/>
		</time_left>
		<btn_accept x="46" y="106" width="136" height="25">
			<text font="letterica16" y="2">st_netcoop_barter_accept_btn</text>
			<texture>ui_button_ordinary</texture>
		</btn_accept>
		<btn_decline x="218" y="106" width="136" height="25">
			<text font="letterica16" y="2">st_netcoop_barter_decline_btn</text>
			<texture>ui_button_ordinary</texture>
		</btn_decline>
	</barter_request>
</w>
