[car_definition]
character_scraper
time_to_explosion			= 0 ;-- time to explode when damaged (ms)
camera_pos        			= -0.366, 1.361, 0.178
	
camera_pos_firsteye			= -0.366, 1.361, 0.178
camera_pos_lookat			= 0.0, 1.67, -0.3
;camera_pos_free				= 0.0, 1.27, -0.3
camera_pos_free				= 0.0, 1.77, -0.5
	
driving_wheels				= back_left_wheel,back_right_wheel					; ведущие колёса
steering_wheels				= front_left_wheel,front_right_wheel					; рулевые колёса
breaking_wheels				= back_left_wheel,back_right_wheel,front_left_wheel,front_right_wheel 	; тормозящие колёса
doors						= left_door,right_door;,front_door							; двери
steer						= stearing_wheel 							; руль
driver_place				= seat_left 								; место водителя
exhausts					= exhausts 								; выхлопная труба
;exhaust_particles			= vehiclefx\exhaust_1
damage						= damage_bones
trunk_bone					= front_door
nitro						= true
nitro_power_factor			= 1.2
nitro_fuel_factor			= 1.4
nitro_particles_enabled		= false

collision_hit_threshold = 0.2 ; [LA DC] minimum physical collision damage to be applied to car (vanilla is 5.0)

;-------------------------------------------------------------------------------
;------ Factory parameters of Engine -------------------------------------------

fuel_tank					= 40 ;40		; L
fuel_consumption  			= 0 ;6		; L / (100k R); liters per 100 000 rotations
engine_power				= 8.3		; horse_power (kW=hp*0.808) max power
max_power_rpm				= 3900		; (nominal rpm ) on this rpm value engine power reaches maximum, must be within every diapason 	- shift down/ shift up
max_torque_rpm				= 2600		; on this rpm engine torque reaches maximum

power_increment_factor		= 0.007
power_decrement_factor		= 0.08
rpm_increment_factor		= 0.05
rpm_decrement_factor		= 0.1
m_power_neutral_factor		= 0.75

; additional engine parameters

max_engine_rpm			= 5000		; rpm (5000) rpm will never be more
idling_engine_rpm		= 850       	; rpm (750) min rpm - starts from this rpm value

;-------------------------------------------------------------------------------
;------ Adjustment a wheel -----------------------------------------------------

reference_radius		= 0.32		; Радиус колеса, используемый при просчёте двигателя
axle_friction			= 3    ; Ослабление скорости в неетральной позиции. (N*m)
steering_speed			= 0.81         	; Время поворота рулевого колеса, в максимум. rps (1)
steering_torque			= 100000    	; Сила гидроусилителя руля. (N*m)
break_torque			= 0.06        	; Сила тормозных колодок. (N*m)
break_time				= 1.0         	; время нарастания силы торможения до максимума, при подтормаживании (стрелка назад)
hand_break_torque		= 0.055        	; сила торможения пробелом (по умолчанию = break_torque)

;-------------------------------------------------------------------------------
;------ Gearbox ----------------------------------------------------------------

main_gear_ratio			= 16.3        	; Передаточное отношение
auto_transmission		= on            ; Автоматическая коробка (on/off)

[transmission_gear_ratio]
										; shift down/ shift up. (rpm, необходимое для переключения)
R	= 3.60, 1950, 4530	
N1	= 3.60, 1950, 4530
N2	= 1.87, 1950, 4530
N3	= 1.11, 2075, 4530
N4	= 0.72, 2200, 4530
				
