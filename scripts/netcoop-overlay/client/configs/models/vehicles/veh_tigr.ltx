max_engine_rpm    			= 4500		;-- max rpm
idling_engine_rpm			= 850			;-- min rpm

;-------------------------------------------------------------------------------
;------ Adjustment a wheel -----------------------------------------------------

reference_radius  			= 0.6		;-- radius of the wheel used in engine failures
axle_friction     			= 5	;-- reducing the speed neutral position (N * m)
steering_speed    			= 0.58			;-- time-turn the steering wheel, the maximum: rps(1)
steering_torque   			= 200000	;-- strength of power steering (N * m)
break_torque      			= 0.05		;-- strength of brake pads (N * m)
break_time        			= 0.9			;-- rise time to the maximum braking force
hand_break_torque 			= 0.02		;-- braking force space (default = break_torque)
steer_nonlinear				= true
steer_invert				= false
break_abs					= true

;-------------------------------------------------------------------------------
;------ Gearbox ----------------------------------------------------------------

main_gear_ratio    			= 21.2 ;31.2		;-- main ratio
auto_transmission  			= on			;-- automatic gear (on/off); when off use shift up/down to change gear
transmission_switch_delay   = 0.45

[transmission_gear_ratio]
;-- shift down / shift up (rpm, needed to switch)
R	= 3.63,  1725, 4290
N1	= 3.63,  1725, 4290
N2 	= 2.05,  1725, 4290
N3 	= 1.37,  1850, 4290
N4 	= 0.98,  1975, 4290
N5 	= 0.73,  2100, 4290

