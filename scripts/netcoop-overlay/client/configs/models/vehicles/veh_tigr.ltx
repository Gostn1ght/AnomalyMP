exhaust_particles 			= vehiclefx\exhaust_1 ;-- particle for exhaust pipe
damage              		= damage_bones ;-- bones damage coeffs
trunk_bone					= kabina
nitro						= true
nitro_power_factor			= 1.2
nitro_fuel_factor			= 1.4
nitro_particles_enabled		= false

collision_hit_threshold 	= 0.2 ; [LA DC] minimum physical collision damage to be applied to car (vanilla is 5.0)

;-------------------------------------------------------------------------------
;------ Factory parameters of Engine -------------------------------------------

fuel_tank         			= 140			;-- litres
fuel_consumption  			= 0				;-- liters per 100 000 rotations
engine_power      			= 19.5 ;20.2			;-- horse_power (kW = hp * 0.808)
max_power_rpm     			= 3500 ;3750		;-- on this rpm value engine power reaches maximum
max_torque_rpm    			= 1100 ;2400		;-- on this rpm engine torque reaches maximum
sound_rpm					= 2650
diff_lock					= true
diff_lock_power				= 1.2

power_increment_factor		= 0.01		;-- power increment coeff
power_decrement_factor		= 0.2 ;0.08			;-- power decrement coeff
rpm_increment_factor		= 0.09			;-- rpm increment coeff
rpm_decrement_factor		= 0.18			;-- power decrement coeff
