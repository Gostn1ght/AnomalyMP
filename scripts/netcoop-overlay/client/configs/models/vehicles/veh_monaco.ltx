;-- ;physics\vehicles\monaco\veh_monaco.ogf (vehicle_monaco)
;-- Dodge Monaco 1974 Definitive Car Pack
;-- Конвертрация в сталкер: Videoton
;-- Модель взята из DriverSF 2011

[disable]
linear_factor		= 0.3
angular_factor		= 0.3

;-------------------------------------------------------------------------------

[car_definition]
character_scraper
time_to_explosion		= 0 ;-- time to explode when damaged (ms)
camera_pos				= -0.432, 1.335, 0.093

camera_pos_firsteye		= -0.432, 1.335, 0.093
camera_pos_lookat		= 0.0, 1.66, -0.92
;camera_pos_free			= -1, 0.75, -0.33
camera_pos_free			= 0.0, 1.76, -1.12

driving_wheels			= back_left_wheel, back_right_wheel ;-- driving wheels
steering_wheels			= front_left_wheel, front_right_wheel ;-- steering wheels
breaking_wheels			= front_left_wheel, front_right_wheel, back_left_wheel, back_right_wheel ;-- breaking wheels
doors					= left_door, right_door ;-- vehicle doors (entrance)
steer					= stearing_wheel ;-- stearing wheel
driver_place			= seat_left ;-- driver's seat
exhausts				= exhausts ;-- exhaust pipe
;exhaust_particles 		= tests\_flame_burst_01
damage					= damage_bones ;-- bones damage coeffs
trunk_bone 				= back_door;
nitro						= true
nitro_power_factor			= 1.2
nitro_fuel_factor			= 1.4
nitro_particles_enabled		= false

collision_hit_threshold = 0.2 ; [LA DC] minimum physical collision damage to be applied to car (vanilla is 5.0)

;-------------------------------------------------------------------------------
;------ Factory parameters of Engine -------------------------------------------

fuel_tank         		= 95		;-- litres
fuel_consumption  		= 0			;-- liters per 100 000 rotations
engine_power      		= 65		;-- horse_power (kW = hp * 0.808)
max_power_rpm     		= 4250		;-- on this rpm value engine power reaches maximum
max_torque_rpm    		= 2850		;-- on this rpm engine torque reaches maximum	

;ph_mass			 		= 5000

power_increment_factor	= 0.018 ;15	 ;-- power increment coeff
power_decrement_factor	= 0.08 ;0.08 ;-- power decrement coeff
rpm_increment_factor	= 0.04		 ;-- rpm increment coeff
rpm_decrement_factor	= 0.13		 ;-- power decrement coeff
m_power_neutral_factor	= 0.30	     ;-- ???

max_engine_rpm    		= 5000	;-- max rpm
idling_engine_rpm		= 900	;-- min rpm

;-------------------------------------------------------------------------------
;------ Adjustment a wheel -----------------------------------------------------

reference_radius  		= 0.34	        ;-- radius of the wheel used in engine failures
axle_friction     		= 100			;-- reducing the speed neutral position (N * m)
steering_speed    		= 0.85		    ;-- time-turn the steering wheel, the maximum: rps(1)
steering_torque   		= 200000			;-- strength of power steering (N * m)
break_torque      		= 0.3           ;-- strength of brake pads (N * m)
break_time        		= 0.7			;-- rise time to the maximum braking force
hand_break_torque 		= 0.2  	        ;-- braking force space (default = break_torque)

;-------------------------------------------------------------------------------
;------ Gearbox ----------------------------------------------------------------

main_gear_ratio    		= 7.2		    ;-- main ratio
auto_transmission  		= on			;-- automatic gear (on/off); when off use shift up/down to change gear

[transmission_gear_ratio]
;-- shift down / shift up (rpm, needed to switch)
R	= 2.30, 1900, 4690
N1 	= 2.10, 1900, 4690
N2	= 1.12, 1900, 4690
N3 	= 0.73, 2025, 4690

;-------------------------------------------------------------------------------
;------ Rest Adjustment --------------------------------------------------------

[lights]
headlights         		= f1, f2

[f1]
bone               		= left_light
color              		= 1.25,1.25,1.25,1
range              		= 49
cone_angle         		= 57
spot_texture       		= lights\lights_bspot01_cv
glow_texture       		= glow\glow_Yellow
glow_radius        		= 1

[f2]
bone               		= right_light
color              		= 1.25,1.25,1.25,1
range              		= 49
cone_angle         		= 57
spot_texture       		= lights\lights_bspot01_cv
glow_texture       		= glow\glow_Yellow
glow_radius        		= 1

[car_sound]
snd_volume         			= 1.0
snd_name           			= car\muscle_run
engine_sound_start_dellay	= 0.4
engine_start				= car\muscle_start
engine_stop					= car\muscle_stop
transmission_switch			= car\o_car_gear_auto
explosion_sound    			= weapons\heli_explosion
relative_pos       			= -0.1, 0.5, 2.1

;-------------------------------------------------------------------------------
;------ animations params ------------------------------------------------------

[doors]
open_torque_factor		= 5		;-- delay for opening the door (default = 2)

[animations]
driver_animation_type	= 2

;-------------------------------------------------------------------------------
;------ damage params ----------------------------------------------------------

[damage_particles]
explosion_particles			= explosions\expl_car
car_damage_particles1		= explosions\expl_car_smoke_small
car_damage_particles2		= explosions\expl_car_smoke_big
wheels_damage_particles1	= vehiclefx\exhaust_1
wheels_damage_particles2	= vehiclefx\exhaust_1

particle_bones1		= front_bamper
particle_bones2		= root

;-------------------------------------------------------------------------------
;------ particle bones ---------------------------------------------------------

[particle_bones]
root			= 0, -0.25, 2.1
front_bamper	= 0, -0.1, -0.5

;-------------------------------------------------------------------------------
;------ damage items -----------------------------------------------------------

[damage_items]
back_left_wheel   	= 0
back_right_wheel  	= 0
front_left_wheel  	= 0
front_right_wheel 	= 0
left_door         	= 0
right_door        	= 0
back_door			= 0

;-------------------------------------------------------------------------------
;------ collisiondamage --------------------------------------------------------

[collision_damage]
root				 = 0.00009
front_bamper		 = 0.0001
back_axle			 = 0.00008
back_bamper			 = 0.00008
kabina				 = 0.00009
back_left_wheel		 = 0.00001
back_right_wheel	 = 0.00001
front_left_wheel	 = 0.00001
front_right_wheel	 = 0.00001

;-------------------------------------------------------------------------------
;------ damage bones -----------------------------------------------------------

[damage_bones]
;bone_name     			= <hit_scale>,<-1>,<wound_scale>
;<hit_scale>			- coeff, reduce health
;<wound_scale> 			- coeff, wounds

default       			= 1, -1, 0.1

[immunities]
;-- 0.0 => 100% invulnerable
;-- 1.0 => 100% vulnerable
burn_immunity         	= 0.12		;-- burn (fire)
strike_immunity       	= 0.008	;-- strike (collision with objects) => collision_damage
shock_immunity        	= 0.07	;-- shock (anom)
wound_immunity        	= 0.0		;-- wound
radiation_immunity    	= 0.0		;-- radiation
telepatic_immunity    	= 0.0		;-- telepathy
chemical_burn_immunity 	= 0.07	;-- chemical burn (anom)
explosion_immunity    	= 0.14		;-- explosion
fire_wound_immunity   	= 0.016	;-- bullets hits

;-------------------------------------------------------------------------------
;----------------explosion params-----------------------------------------------

[explosion]
blast					= 1
blast_r					= 15
blast_impulse			= 350
frags		        	= 15
frags_r					= 30
frag_hit				= 0.5
frag_hit_impulse		= 350
hit_type_blast			= explosion
hit_type_frag			= fire_wound
up_throw_factor			= 0.25
wm_size            	    = 0.1
explode_particles		= explosions\expl_car
light_color				= 0.6, 0.5, 0.3
light_range				= 15.0
light_time 				= 0.5

fragment_speed			= 76
fragment_tracer_max_length	= 3
explode_duration    	= 50

snd_explode 		= weapons\heli_explosion
wallmark_section	= explosion_marks

[explode_effector]
effect_sect_name = effector_explode_hit ;-- misc\postprocess.ltx
time					= 0.75
amplitude			    = 5.0
period_number	        = 50

;-------------------------------------------------------------------------------
;------ Others params ----------------------------------------------------------

[air_resistance]
linear_factor			= 8500.f
angular_factor			= 500.f

[wheels_params]
suspension_distance = 0.20
suspension_force_inc = 50
suspension_spring_factor = 1
suspension_damping_factor = 5
suspension_inertia = 0.5
damping_factor			= 2
spring_factor			= 1
friction_factor			= 1

[front_left_wheel]
break_torque			= 0.02
hand_break_torque		= 0.002
damping_factor          = 2
spring_factor           = 1
friction_factor			= 1.09

[front_right_wheel]
break_torque			= 0.02
hand_break_torque		= 0.002
damping_factor          = 2
spring_factor           = 1
friction_factor			= 1.09

[back_left_wheel]
break_torque			= 0.015
hand_break_torque		= 0.035
damping_factor          = 2
spring_factor           = 1
friction_factor			= 1.13

[back_right_wheel]
break_torque			= 0.015
hand_break_torque		= 0.035
damping_factor          = 2
spring_factor           = 1
friction_factor			= 1.13

[collide]
not_collide_parts		= 1

;-------------------------------------------------------------------------------
;------ destroyed part ---------------------------------------------------------

[destroyed]
physics\vehicles\veh_empty
;;physics\vehicles\niva\part\veh_niva_u_02_part0 ; car chassis
;physics\vehicles\niva\part\veh_niva_u_02_part1 ; back-left wheel
;physics\vehicles\niva\part\veh_niva_u_02_part2 ; front-left wheel
;physics\vehicles\niva\part\veh_niva_u_02_part3 ; front-right wheel
;physics\vehicles\niva\part\veh_niva_u_02_part4 ; back-right wheel
;;physics\vehicles\niva\part\veh_niva_u_02_part5 ; front bumper
;;physics\vehicles\niva\part\veh_niva_u_02_part6 ; back door
;;physics\vehicles\niva\part\veh_niva_u_02_part7 ; left door
;;physics\vehicles\niva\part\veh_niva_u_02_part8 ; right door

[autoremove_parts]
time	= 180

;-------------------------------------------------------------------------------
;--- part impulse_transition ---------------------------------------------------

[impulse_transition_to_parts]
random_min               = 10.0
random_hit_imp           = 1.0
;ref_bone                =
imp_transition_factor    = 1.0
lv_transition_factor     = 0.5
av_transition_factor     = 0.5

;-------------------------------------------------------------------------------
;------ End params -------------------------------------------------------------