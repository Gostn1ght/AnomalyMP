#include "common.h"
#include "netcoop_menu_light.h"
struct preview_vertex { float4 position : SV_Position; float2 uv : TEXCOORD0; float3 normal : TEXCOORD1; float3 world : TEXCOORD2; float4 shadow : TEXCOORD3; };
float4 main(preview_vertex vertex) : SV_Target
{
    // Actor texture alpha stores material data, not transparency.
    float3 diffuse=s_base.Sample(smp_base,vertex.uv).rgb;
    float gloss;
    float3 normal=menu_surface_normal(vertex.normal,vertex.world,vertex.uv,gloss);
    // The seated character is interactive object 3.
    float3 lit=menu_highlight(menu_light(diffuse,normal,vertex.world,vertex.shadow,gloss),normal,vertex.world,3);
    return float4(lit*menu_vignette(vertex.position),1);
}
