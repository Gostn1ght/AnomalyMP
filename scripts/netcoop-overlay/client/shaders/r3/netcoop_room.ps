#include "common.h"
#include "netcoop_menu_light.h"
struct room_output { float4 position : SV_Position; float4 color : COLOR0; float2 uv : TEXCOORD0; float3 normal : TEXCOORD1; float3 world : TEXCOORD2; float4 shadow : TEXCOORD3; };
float4 main(room_output vertex) : SV_Target
{
    float3 diffuse=s_base.Sample(smp_base,vertex.uv).rgb;
    float gloss;
    float3 normal=menu_surface_normal(vertex.normal,vertex.world,vertex.uv,gloss);
    float3 lit=lerp(menu_light(diffuse,normal,vertex.world,vertex.shadow,gloss),diffuse*float3(1.5,1.3,.9),vertex.color.a);
    // Vertex colour RGB carries the interactive object id (255 = none).
    lit=menu_highlight(lit,normal,vertex.world,round(vertex.color.r*255));
    return float4(lit*menu_vignette(vertex.position),1);
}
