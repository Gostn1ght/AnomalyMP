-- PDA network tabs (owner 2026-10-10, after New Way; docs/audit/89):
-- Общий канал, Чаты, Контакты, Галерея, Фото, Диктофон, Заметки. Every
-- tab shows the PDA clock at the top and "name - UID" at the bottom. Data
-- and commands: netcoop_pdanet_client.
-- Fixed rows with paging (like the faction window) instead of scroll lists.

local function tr(id) return game.translate_string(id) end
local net = function() return netcoop_pdanet_client end
local XML = "ui_netcoop_pdanet.xml"

-- group icons ("Значок"): the faction emblems of the main menu
local ICONS = { "ui_mm_faction_stalker", "ui_mm_faction_dolg", "ui_mm_faction_freedom", "ui_mm_faction_csky",
	"ui_mm_faction_ecolog", "ui_mm_faction_army", "ui_mm_faction_bandit", "ui_mm_faction_killer",
	"ui_mm_faction_monolith", "ui_mm_faction_greh", "ui_mm_faction_isg", "ui_mm_faction_renegade" }

local function at(w, x, y, wd, h)
	w:SetWndPos(vector2():set(x, y))
	if wd then w:SetWndSize(vector2():set(wd, h)) end
	return w
end
local function text(w, s) w:TextControl():SetText(s or "") end
local function edit_text(e) return e and e:GetText() or "" end

local function icon_texture(st, icon)
	if icon and icon ~= "" then st:InitTexture(icon) else st:InitTexture("ui\\ui_noise") end
end

local function my_line()
	local me = net().me
	if me.uid == "" then return tr("st_pdanet_connecting") end
	return string.format("%s  -  UID %s", me.name, me.uid)
end

-- Base for every tab window: frame, title, clock, footer, button helper.
local function base(self, title)
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	self:SetAutoDelete(false)
	self.xml = CScriptXmlInit()
	self.xml:ParseFile(XML)
	self.xml:InitStatic("frame", self)
	self.title = self.xml:InitStatic("title", self)
	text(self.title, tr(title))
	self.clock = self.xml:InitStatic("clock", self)
	self.status = self.xml:InitStatic("status", self)
	self.ids, self.tick_at = 0, 0
end
-- Clock and footer, once a second (CUIScriptWnd:Update of each tab).
local function tick(self, extra)
	if time_global() < self.tick_at then return end
	self.tick_at = time_global() + 1000
	text(self.clock, net().clock())
	if extra then extra() end
end
local function footer(self, prefix)
	text(self.status, (prefix and prefix ~= "" and (prefix .. "     ") or "") .. my_line())
end
local function button(self, caption, x, y, w, h, fn, template)
	local b = at(self.xml:Init3tButton(template or "button", self), x, y, w, h)
	text(b, caption)
	self.ids = self.ids + 1
	local id = "b" .. self.ids
	self:Register(b, id)
	self:AddCallback(id, ui_events.BUTTON_CLICKED, fn, self)
	return b
end
local function static(self, name, x, y, w, h)
	return at(self.xml:InitStatic(name, self), x, y, w, h)
end
local function status_of(c)
	return c.online == true and tr("st_pdanet_online") or c.online == false and tr("st_pdanet_offline") or tr("st_pdanet_status_hidden")
end
local function tip(id, ...)
	if actor_menu and actor_menu.set_msg then actor_menu.set_msg(1, string.format(tr(id), ...), 3) end
end

----------------------------------------------------------------------
-- Общий канал
----------------------------------------------------------------------
local GEN_ROWS = 9

class "pdanet_general" (CUIScriptWnd)
function pdanet_general:__init() super()
	base(self, "st_pdanet_tab_general")
	self.anon, self.scroll = false, 0
	self.layout = static(self, "msg_head", 520, 104, 260, 24)
	static(self, "panel", 36, 134, 748, 476)
	self.rows = {}
	for r = 1, GEN_ROWS do
		local y = 140 + (r - 1) * 52
		self.rows[r] = {
			icon = static(self, "icon", 44, y + 4, 48, 36),
			name = static(self, "msg_name", 100, y, 300, 20),
			head = static(self, "msg_head", 404, y, 330, 20),
			body = static(self, "msg_text", 100, y + 20, 640, 30),
		}
	end
	button(self, "^", 746, 140, 32, 30, function() self.scroll = self.scroll + 3; self:Fill() end)
	button(self, "v", 746, 574, 32, 30, function() self.scroll = math.max(0, self.scroll - 3); self:Fill() end)
	self.input = at(self.xml:InitEditBox("edit", self), 44, 620, 580, 34)
	button(self, tr("st_pdanet_send"), 632, 620, 152, 34, function() self:Send() end)
	self.anon_btn = button(self, "", 44, 660, 240, 26, function() self.anon = not self.anon; self:Fill() end)
	net().on_change(function() if self:IsShown() then self:Fill() end end)
	self:Fill()
end
function pdanet_general:Update()
	CUIScriptWnd.Update(self)
	tick(self, function()
		-- keyboard layout of the input (engine), like New Way's "Раскладка: EN"
		local lang = netcoop_keyboard_layout and netcoop_keyboard_layout() or ""
		text(self.layout, lang ~= "" and (tr("st_pdanet_layout") .. " " .. lang) or "")
	end)
end
function pdanet_general:Send()
	net().say(edit_text(self.input), self.anon)
	self.input:SetText("")
	self.scroll = 0
end
function pdanet_general:Fill()
	local list = net().general
	local last = #list - self.scroll
	for r = 1, GEN_ROWS do
		local m = list[last - GEN_ROWS + r]
		local row = self.rows[r]
		for _, w in pairs(row) do w:Show(m ~= nil) end
		if m then
			text(row.name, net().sender_name(m))
			text(row.head, net().when_long(m))
			text(row.body, m.x)
			icon_texture(row.icon, m.i)
		end
	end
	text(self.anon_btn, (self.anon and "[x] " or "[ ] ") .. tr("st_pdanet_anonymous_mode"))
	footer(self)
end
function pdanet_general:OnKeyboard(dik, action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, action)
	if action == ui_events.WINDOW_KEY_PRESSED and dik == DIK_keys.DIK_RETURN then self:Send() end
	return res
end

----------------------------------------------------------------------
-- Чаты
----------------------------------------------------------------------
local LIST_ROWS, MSG_ROWS, PICK_ROWS = 8, 7, 8

-- What a message shows in a bubble.
local function message_body(m)
	if m.k == "point" then return tr("st_pdanet_point") .. ": " .. (m.x or "") end
	if m.k == "transfer" then
		return string.format(tr(m.own and "st_pdanet_transfer_out" or "st_pdanet_transfer_in"), tostring(m.d or "?"))
	end
	if m.k == "voice" then
		local secs = tonumber(string.match(m.d or "", "^%S+ (%d+)") or 0) or 0
		return string.format(tr("st_pdanet_voice_msg"), string.format("%d:%02d", math.floor(secs / 60), secs % 60))
	end
	if m.k == "photo" then return tr("st_pdanet_photo_msg") end
	return m.x
end

class "pdanet_chats" (CUIScriptWnd)
function pdanet_chats:__init() super()
	base(self, "st_pdanet_tab_chats")
	self.list_scroll, self.msg_scroll, self.points, self.voices = 0, 0, {}, {}
	static(self, "panel", 36, 134, 268, 456)
	static(self, "panel", 312, 104, 472, 50)
	static(self, "panel", 312, 158, 472, 392)
	self.rows = {}
	for r = 1, LIST_ROWS do
		local y = 140 + (r - 1) * 56
		local row = {}
		row.btn = button(self, "", 40, y, 226, 52, function() self:Pick(r) end, "row")
		row.icon = static(self, "icon", 44, y + 8, 48, 36)
		row.name = static(self, "msg_name", 96, y + 4, 130, 20)
		row.time = static(self, "msg_head", 210, y + 4, 56, 20)
		row.last = static(self, "msg_head", 96, y + 26, 140, 20)
		row.unread = static(self, "msg_name", 236, y + 26, 30, 20)
		self.rows[r] = row
	end
	button(self, "^", 270, 140, 30, 30, function() self.list_scroll = math.max(0, self.list_scroll - 1); self:Fill() end)
	button(self, "v", 270, 554, 30, 30, function() self.list_scroll = self.list_scroll + 1; self:Fill() end)
	button(self, tr("st_pdanet_new_group"), 36, 596, 268, 32, function() self:Dialog("group") end)
	-- the conversation header: Перевод (private) or Состав (group), Удалить чат
	self.peer_icon = static(self, "icon", 320, 110, 48, 36)
	self.peer_name = static(self, "msg_name", 376, 108, 200, 20)
	self.peer_info = static(self, "msg_head", 376, 128, 200, 20)
	self.side_btn = button(self, "", 580, 112, 100, 30, function()
		local s = net().opened and net().opened.summary or {}
		if s.kind == "g" then net().ask_members(self.chat); self:Dialog("members") else self:Dialog("pay") end
	end)
	self.del_btn = button(self, tr("st_pdanet_delete_chat"), 684, 112, 96, 30, function()
		if self.chat then net().delete_chat(self.chat); self.chat = nil; net().opened = nil; self:Fill() end
	end)
	self.empty = static(self, "hint", 330, 300, 440, 120)
	self.msgs = {}
	for r = 1, MSG_ROWS do
		local y = 162 + (r - 1) * 54
		local m = {}
		m.icon = static(self, "icon", 318, y + 4, 40, 30)
		m.head = static(self, "msg_head", 364, y, 260, 20)
		m.body = static(self, "msg_text", 364, y + 20, 380, 30)
		m.own = static(self, "msg_own", 400, y + 20, 340, 30)
		m.mark = button(self, tr("st_pdanet_mark"), 620, y + 2, 156, 22, function() self:Mark(r) end)
		m.play = button(self, ">", 620, y + 2, 40, 22, function() self:Play(r) end)
		self.msgs[r] = m
	end
	button(self, "^", 750, 162, 30, 26, function() self.msg_scroll = self.msg_scroll + 2; self:Fill() end)
	button(self, "v", 750, 520, 30, 26, function() self.msg_scroll = math.max(0, self.msg_scroll - 2); self:Fill() end)
	self.photo_btn = button(self, tr("st_pdanet_photo_btn"), 312, 556, 152, 30, function() end)
	self.point_btn = button(self, tr("st_pdanet_point_btn"), 472, 556, 152, 30, function()
		if self.chat then net().post_point(self.chat, edit_text(self.input)); self.input:SetText("") end
	end)
	self.voice_btn = button(self, tr("st_pdanet_voice_btn"), 632, 556, 152, 30, function() self:VoiceMessage() end)
	self.photo_btn:Enable(false)
	self.input = at(self.xml:InitEditBox("edit", self), 312, 594, 330, 32)
	button(self, tr("st_pdanet_send"), 650, 594, 134, 32, function() self:Send() end)
	-- dialogs over the conversation: new group, members, transfer
	self.dlg = {}
	self.dlg.back = static(self, "panel", 330, 150, 440, 420)
	self.dlg.title = static(self, "msg_name", 346, 158, 408, 24)
	self.dlg.icon = static(self, "icon", 346, 188, 48, 36)
	self.dlg.icon_btn = button(self, tr("st_pdanet_icon"), 400, 190, 110, 30, function()
		self.icon_n = self.icon_n % #ICONS + 1
		icon_texture(self.dlg.icon, ICONS[self.icon_n])
	end)
	self.dlg.name = at(self.xml:InitEditBox("edit", self), 516, 190, 238, 30)
	self.dlg.amount = at(self.xml:InitEditBox("edit_amount", self), 346, 230, 200, 30)
	self.dlg.rows, self.picked, self.icon_n = {}, {}, 1
	for r = 1, PICK_ROWS do
		self.dlg.rows[r] = button(self, "", 346, 230 + (r - 1) * 34, 408, 30, function() self:Toggle(r) end, "row")
	end
	self.dlg.ok = button(self, "", 346, 528, 196, 30, function() self:DialogOk() end)
	self.dlg.cancel = button(self, tr("st_pdanet_cancel"), 558, 528, 196, 30, function() self:Dialog(nil) end)
	self:Dialog(nil)
	net().on_change(function() if self:IsShown() then self:Fill() end end)
	self:Fill()
end
function pdanet_chats:Update()
	CUIScriptWnd.Update(self)
	tick(self, function()
		local v = netcoop_pdanet_voice
		local busy = v and (v.recording() or v.uploading() or (netcoop_play_pos and netcoop_play_pos() >= 0))
		if busy or net().typing_in(self.chat or "") or self.typing_shown then self:Fill() end
	end)
end
function pdanet_chats:Pick(r)
	local c = net().chats[self.list_scroll + r]
	if not c then return end
	self.chat, self.msg_scroll = c.id, 0
	net().open_chat(c.id)
	self:Fill()
end
function pdanet_chats:Send()
	if not self.chat then return end
	net().post(self.chat, edit_text(self.input))
	self.input:SetText("")
	self.msg_scroll = 0
end
function pdanet_chats:Mark(r)
	local m = self.points[r]
	if not m or not m.d then return end
	local lvl, x, y, z = string.match(m.d, "^([%w_]+) (%S+) (%S+) (%S+)$")
	if lvl ~= level.name() then
		actor_menu.set_msg(1, string.format(tr("st_pdanet_point_other_level"), game.translate_string(lvl or "")), 4)
		return
	end
	local paw = tasks_placeable_waypoints
	local sz = paw and paw.register_script_zone and paw.register_script_zone(vector():set(tonumber(x), tonumber(y), tonumber(z)), 0, 0)
	if sz and paw.func_pn_add then
		paw.func_pn_add({ id = sz.id, name = m.x ~= "" and m.x or tr("st_pdanet_point") })
		actor_menu.set_msg(1, tr("st_pdanet_point_added"), 3)
	end
end
-- Voice messages (netcoop_pdanet_voice: record, send, play).
function pdanet_chats:VoiceMessage()
	local v = netcoop_pdanet_voice
	if not (self.chat and v) then return end
	if v.recording_kind() == "msg" then
		v.stop_and_send(self.chat)
	elseif not v.recording() then
		v.set_chat(self.chat)
		v.start_message()
	end
	self:Fill()
end
function pdanet_chats:Play(r)
	local m = self.voices[r]
	if m and netcoop_pdanet_voice then netcoop_pdanet_voice.play_message(m) end
end
-- mode: nil (closed), "group", "members", "pay"
function pdanet_chats:Dialog(mode)
	self.dialog = mode
	for _, w in pairs(self.dlg) do if type(w) ~= "table" then w:Show(mode ~= nil) end end
	for _, w in ipairs(self.dlg.rows) do w:Show(false) end
	local group, pay = mode == "group", mode == "pay"
	for _, w in ipairs({ self.dlg.icon, self.dlg.icon_btn, self.dlg.name }) do w:Show(group) end
	self.dlg.amount:Show(pay)
	self.dlg.ok:Show(group or pay)
	text(self.dlg.cancel, tr(mode == "members" and "st_pdanet_close" or "st_pdanet_cancel"))
	if group then
		self.picked, self.icon_n = {}, 1
		self.dlg.name:SetText("")
		icon_texture(self.dlg.icon, ICONS[1])
		text(self.dlg.title, tr("st_pdanet_new_group"))
		text(self.dlg.ok, tr("st_pdanet_create"))
	elseif pay then
		self.dlg.amount:SetText("")
		local p = net().opened and net().opened.summary and net().opened.summary.peer or {}
		text(self.dlg.title, string.format(tr("st_pdanet_transfer_to"), p.name or ("UID " .. tostring(p.uid)),
			db.actor and db.actor:money() or 0))
		text(self.dlg.ok, tr("st_pdanet_send_money"))
	elseif mode == "members" then
		text(self.dlg.title, tr("st_pdanet_members_btn"))
	end
	if mode then self:FillDialog() end
end
function pdanet_chats:FillDialog()
	local rows = self.dlg.rows
	for r = 1, PICK_ROWS do rows[r]:Show(false) end
	if self.dialog == "group" then
		local list = net().contacts
		for r = 1, PICK_ROWS do
			local c = list[r]
			if c then
				rows[r]:Show(true)
				text(rows[r], string.format("[%s] %s  (UID %s)", self.picked[c.uid] and "x" or " ", c.name or "?", c.uid))
			end
		end
	elseif self.dialog == "members" then
		local list = net().members[self.chat or ""] or {}
		for r = 1, PICK_ROWS do
			local c = list[r]
			if c then
				rows[r]:Show(true)
				text(rows[r], string.format("%s  (UID %s)  -  %s", c.name or "?", c.uid, c.own and tr("st_pdanet_you") or status_of(c)))
			end
		end
	end
end
function pdanet_chats:Toggle(r)
	if self.dialog ~= "group" then return end
	local c = net().contacts[r]
	if c then self.picked[c.uid] = not self.picked[c.uid] or nil; self:FillDialog() end
end
function pdanet_chats:DialogOk()
	if self.dialog == "group" then
		local uids = {}
		for uid in pairs(self.picked) do uids[#uids + 1] = uid end
		if #uids == 0 then return end
		net().new_group(edit_text(self.dlg.name), ICONS[self.icon_n], uids)
	elseif self.dialog == "pay" then
		local amount = tonumber(edit_text(self.dlg.amount))
		if not (self.chat and amount and amount > 0) then return end
		if db.actor and amount > db.actor:money() then tip("st_pdanet_no_money") return end
		net().pay(self.chat, amount)
	end
	self:Dialog(nil)
end
local function summary_line(c)
	if c.kind == "g" then return c.name or "?" end
	local p = c.peer or {}
	return p.name or ("UID " .. tostring(p.uid))
end
function pdanet_chats:Fill()
	local list = net().chats
	for r = 1, LIST_ROWS do
		local c = list[self.list_scroll + r]
		local row = self.rows[r]
		for _, w in pairs(row) do w:Show(c ~= nil) end
		if c then
			text(row.name, summary_line(c))
			local last = c.last or {}
			text(row.time, last.g and string.sub(net().when(last), 1, 5) or "")
			text(row.last, last.k and message_body(last) or "")
			text(row.unread, (c.unread or 0) > 0 and tostring(c.unread) or "")
			icon_texture(row.icon, c.kind == "g" and c.icon or (c.peer and c.peer.icon))
		end
	end
	local o = net().opened
	local open = o and self.chat and o.id == self.chat
	self.empty:Show(not open)
	text(self.empty, tr("st_pdanet_chats_hint"))
	for _, w in ipairs({ self.peer_icon, self.peer_name, self.peer_info, self.del_btn, self.side_btn }) do w:Show(open and true or false) end
	self.points, self.voices, self.typing_shown = {}, {}, false
	if open then
		local s = o.summary or {}
		text(self.peer_name, summary_line(s))
		text(self.side_btn, tr(s.kind == "g" and "st_pdanet_members_btn" or "st_pdanet_transfer"))
		local typing = net().typing_in(o.id)
		if typing then
			self.typing_shown = true
			text(self.peer_info, string.format(tr("st_pdanet_typing"), summary_line(s)))
		elseif s.kind == "g" then
			text(self.peer_info, string.format(tr("st_pdanet_members"), s.members or 0, s.online or 0))
		else
			local p = s.peer or {}
			text(self.peer_info, string.format("UID %s  -  %s", tostring(p.uid), status_of(p)))
		end
		icon_texture(self.peer_icon, s.kind == "g" and s.icon or (s.peer and s.peer.icon))
	end
	local msgs = open and o.msgs or {}
	local last = #msgs - self.msg_scroll
	for r = 1, MSG_ROWS do
		local m = msgs[last - MSG_ROWS + r]
		local w = self.msgs[r]
		for _, x in pairs(w) do x:Show(false) end
		if m then
			w.head:Show(true)
			local group = o.summary and o.summary.kind == "g"
			text(w.head, ((m.own or not group) and "" or net().sender_name(m) .. "  ") .. net().when_short(m))
			local body = message_body(m)
			if m.k == "voice" and netcoop_pdanet_voice then
				body = tr("st_pdanet_voice_word") .. "   " .. (netcoop_pdanet_voice.message_progress(m))
			end
			if m.own then w.own:Show(true); text(w.own, body) else w.body:Show(true); text(w.body, body); w.icon:Show(true); icon_texture(w.icon, m.i) end
			if m.k == "point" then w.mark:Show(true); self.points[r] = m end
			if m.k == "voice" then w.play:Show(true); self.voices[r] = m end
		end
	end
	local v = netcoop_pdanet_voice
	local rec = v and v.recording_kind() == "msg"
	text(self.voice_btn, rec and string.format(tr("st_pdanet_voice_stop"), v.recorded_text()) or tr("st_pdanet_voice_btn"))
	local up = v and v.uploading()
	if up then text(self.voice_btn, string.format(tr("st_pdanet_rec_upload"), up)) end
	if self.dialog then self:FillDialog() end
	footer(self, string.format(tr("st_pdanet_unread"), net().unread_total()))
end
function pdanet_chats:OnKeyboard(dik, action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, action)
	if action == ui_events.WINDOW_KEY_PRESSED then
		if dik == DIK_keys.DIK_RETURN then
			if self.dialog then self:DialogOk() else self:Send() end
		elseif self.chat and not self.dialog then net().typed(self.chat) end
	end
	return res
end

----------------------------------------------------------------------
-- Контакты
----------------------------------------------------------------------
local CONTACT_ROWS = 10

class "pdanet_contacts" (CUIScriptWnd)
function pdanet_contacts:__init() super()
	base(self, "st_pdanet_tab_contacts")
	self.scroll = 0
	-- profile card: avatar, PDA name, UID, faction, money
	static(self, "panel", 36, 134, 748, 58)
	self.card_icon = static(self, "icon", 42, 138, 64, 50)
	self.card_name = static(self, "msg_name", 114, 138, 360, 22)
	self.card_info = static(self, "msg_head", 114, 162, 360, 22)
	self.card_money = static(self, "money", 560, 146, 214, 30)
	-- UID field and actions
	static(self, "panel", 36, 196, 748, 38)
	static(self, "msg_head", 44, 200, 40, 30):TextControl():SetText("UID")
	self.uid = at(self.xml:InitEditBox("edit_uid", self), 84, 200, 120, 30)
	button(self, tr("st_pdanet_add"), 212, 200, 130, 30, function()
		net().add_contact(edit_text(self.uid)); self.uid:SetText("")
	end)
	button(self, tr("st_pdanet_open"), 350, 200, 130, 30, function()
		local c = self.selected and net().contacts[self.selected]
		if c then net().open_dm(c.uid) end
	end)
	button(self, tr("st_pdanet_send_point"), 488, 200, 150, 30, function()
		local c = self.selected and net().contacts[self.selected]
		if c then net().send_point_to(c.uid, ""); tip("st_pdanet_point_sent", c.name or c.uid) end
	end)
	button(self, tr("st_pdanet_delete"), 646, 200, 130, 30, function()
		local c = self.selected and net().contacts[self.selected]
		if c then net().remove_contact(c.uid); self.selected = nil end
	end)
	static(self, "panel", 36, 238, 748, 372)
	self.rows = {}
	for r = 1, CONTACT_ROWS do
		local y = 242 + (r - 1) * 36
		self.rows[r] = { btn = button(self, "", 40, y, 700, 33, function() self.selected = self.scroll + r; self:Fill() end, "row"),
			icon = static(self, "icon", 700, y + 2, 36, 28) }
	end
	button(self, "^", 748, 242, 30, 30, function() self.scroll = math.max(0, self.scroll - 3); self:Fill() end)
	button(self, "v", 748, 574, 30, 30, function() self.scroll = self.scroll + 3; self:Fill() end)
	self.empty = static(self, "hint", 60, 380, 700, 60)
	net().on_change(function() if self:IsShown() then self:Fill() end end)
	self:Fill()
end
function pdanet_contacts:Update()
	CUIScriptWnd.Update(self)
	tick(self, function() self:Card() end)
end
function pdanet_contacts:Card()
	local me, a = net().me, db.actor
	text(self.card_name, me.name ~= "" and me.name or (a and a:character_name() or ""))
	local faction = a and a.character_community and tr(a:character_community()) or ""
	text(self.card_info, me.uid ~= "" and string.format("UID %s     %s", me.uid, faction) or tr("st_pdanet_connecting"))
	text(self.card_money, string.format("%d RU", a and a:money() or 0))
	icon_texture(self.card_icon, me.icon ~= "" and me.icon or (a and a.character_icon and a:character_icon()))
end
function pdanet_contacts:Fill()
	local list = net().contacts
	self:Card()
	self.empty:Show(#list == 0)
	text(self.empty, tr("st_pdanet_contacts_empty"))
	for r = 1, CONTACT_ROWS do
		local i = self.scroll + r
		local c = list[i]
		local row = self.rows[r]
		row.btn:Show(c ~= nil); row.icon:Show(c ~= nil)
		if c then
			local unread = net().contact_unread(c.uid)
			text(row.btn, string.format("%s%s   UID %s  -  %s%s", self.selected == i and "> " or "", c.name or "?", c.uid, status_of(c),
				unread > 0 and string.format("     (%d)", unread) or ""))
			icon_texture(row.icon, c.icon)
		end
	end
	footer(self, net().last_error and (tr("st_pdanet_error") .. " " .. tostring(net().last_error)) or "")
end

----------------------------------------------------------------------
-- Заметки (New Way pda_notes): list, title, text; new, save, delete.
-- Kept on the server with the character.
----------------------------------------------------------------------
local NOTE_ROWS = 10

class "pdanet_notes" (CUIScriptWnd)
function pdanet_notes:__init() super()
	base(self, "st_pdanet_tab_notes")
	self.scroll = 0
	static(self, "panel", 36, 134, 268, 456)
	self.rows = {}
	for r = 1, NOTE_ROWS do
		self.rows[r] = button(self, "", 40, 138 + (r - 1) * 44, 226, 40, function() self:Pick(self.scroll + r) end, "row")
	end
	button(self, "^", 270, 140, 30, 30, function() self.scroll = math.max(0, self.scroll - 3); self:Fill() end)
	button(self, "v", 270, 554, 30, 30, function() self.scroll = self.scroll + 3; self:Fill() end)
	button(self, tr("st_pdanet_notes_new"), 36, 596, 268, 32, function() self:Pick(nil) end)
	static(self, "panel", 312, 134, 472, 456)
	static(self, "msg_head", 320, 138, 456, 20):TextControl():SetText(tr("st_pdanet_notes_title"))
	self.title_edit = at(self.xml:InitEditBox("edit", self), 320, 160, 456, 30)
	static(self, "msg_head", 320, 194, 456, 20):TextControl():SetText(tr("st_pdanet_notes_text"))
	self.body_edit = at(self.xml:InitEditBox("edit_note", self), 320, 216, 456, 30)
	self.view = static(self, "note_view", 320, 254, 456, 290)
	self.date = static(self, "msg_head", 320, 550, 456, 24)
	button(self, tr("st_pdanet_notes_save"), 312, 596, 230, 32, function() self:Save() end)
	self.del_btn = button(self, tr("st_pdanet_delete"), 554, 596, 230, 32, function()
		if self.note then net().delete_note(self.note); self:Pick(nil) end
	end)
	self.empty = static(self, "hint", 40, 300, 260, 120)
	net().on_change(function(what) if self:IsShown() and what == "notes" then self:Fill() end end)
	self:Pick(nil)
end
function pdanet_notes:Update()
	CUIScriptWnd.Update(self)
	tick(self)
end
function pdanet_notes:Pick(i)
	local n = i and net().notes[i]
	self.note = n and n.id or nil
	self.title_edit:SetText(n and n.title or "")
	self.body_edit:SetText(n and n.text or "")
	self:Fill()
end
function pdanet_notes:Save()
	local title, body = edit_text(self.title_edit), edit_text(self.body_edit)
	if title == "" and body == "" then return end
	net().save_note(self.note, title, body)
	if not self.note then self.saving_new = true end
end
function pdanet_notes:Fill()
	local list = net().notes
	if self.saving_new and list[1] then self.saving_new = nil; self.note = list[1].id end
	local current
	for r = 1, NOTE_ROWS do
		local n = list[self.scroll + r]
		self.rows[r]:Show(n ~= nil)
		if n then
			text(self.rows[r], (n.id == self.note and "> " or "") .. (n.title ~= "" and n.title or string.sub(n.text or "", 1, 24)))
		end
	end
	for _, n in ipairs(list) do if n.id == self.note then current = n end end
	text(self.view, current and current.text or edit_text(self.body_edit))
	text(self.date, current and net().when(current) or "")
	self.del_btn:Show(current ~= nil)
	self.empty:Show(#list == 0)
	text(self.empty, tr("st_pdanet_notes_empty"))
	footer(self, string.format(tr("st_pdanet_notes_count"), #list))
end
function pdanet_notes:OnKeyboard(dik, action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, action)
	if action == ui_events.WINDOW_KEY_PRESSED and dik == DIK_keys.DIK_RETURN then self:Save() end
	return res
end

