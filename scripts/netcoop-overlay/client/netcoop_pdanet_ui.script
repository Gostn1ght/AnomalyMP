-- Not made yet (photo, gallery): say so.
----------------------------------------------------------------------
class "pdanet_soon" (CUIScriptWnd)
function pdanet_soon:__init(caption) super()
	base(self, caption)
	local h = static(self, "hint", 60, 320, 700, 80)
	text(h, tr(caption .. "_soon"))
	footer(self)
end
function pdanet_soon:Update()
	CUIScriptWnd.Update(self)
	tick(self, function() footer(self) end)
end

----------------------------------------------------------------------
-- Registration (the strip scrolls; 4 tabs visible in the PDA's top bar)
----------------------------------------------------------------------
local windows = {}
local function window(key, make)
	return function()
		windows[key] = windows[key] or make()
		return windows[key]
	end
end

function on_game_start()
	if not (netcoop_pure_client and netcoop_pure_client()) or not pda_dynamic_tabs then return end
	-- after "Карта местности" (eptTasks), in this order
	local after = "eptTasks"
	local dictaphone = function()
		if netcoop_pdanet_voice and netcoop_pdanet_voice.dictaphone_window then return netcoop_pdanet_voice.dictaphone_window() end
		return pdanet_soon("st_pdanet_tab_voice")
	end
	local tabs = {
		{ "st_pdanet_tab_general", function() return pdanet_general() end },
		{ "st_pdanet_tab_chats", function() return pdanet_chats() end },
		{ "st_pdanet_tab_contacts", function() return pdanet_contacts() end },
		{ "st_pdanet_tab_gallery", function() return pdanet_soon("st_pdanet_tab_gallery") end },
		{ "st_pdanet_tab_photo", function() return pdanet_soon("st_pdanet_tab_photo") end },
		{ "st_pdanet_tab_voice", dictaphone },
		{ "st_pdanet_tab_notes", function() return pdanet_notes() end },
	}
	for _, t in ipairs(tabs) do
		after = pda_dynamic_tabs.register(t[1], window(t[1], t[2]), after)
	end
end

-- shared with netcoop_pdanet_voice (the dictaphone tab uses the same frame)
ui = { base = base, tick = tick, footer = footer, button = button, static = static, text = text, at = at, tr = tr }
