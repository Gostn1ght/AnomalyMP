-- NetAnomaly: compatibility layer for a pure netcoop client.
--
-- A remote client has no local ALife simulator: alife() returns nil and the
-- GAMMA Actor binder never runs, so db.actor is never assigned. GAMMA UI
-- scripts (inventory, PDA, options) assume both exist and crash.
--
-- The dedicated server owns the simulation. This layer only lets client UI
-- read the locally controlled Actor; it never simulates or changes the world.
-- Write requests (create/release/teleport/info) are dropped here and must go
-- through server messages.
--
-- Installed from the end of _g.script by scripts/patch-gamma-netcoop-client.ps1.

local installed = false
local native_alife = nil
local warned = {}

local function warn_once(what)
	if warned[what] then return end
	warned[what] = true
	printf("[NetAnomaly] client has no ALife: alife():%s ignored", what)
end

local controlled_actor = nil
local use_own_actor_id -- defined below

-- The locally controlled Actor: set by the engine hook after spawn, or
-- recovered from the view entity when this script loaded too late for it.
local function local_actor()
	if not (level and level.present and level.present()) then
		controlled_actor = nil
		return nil
	end
	if controlled_actor then return controlled_actor end
	local e = level.get_view_entity and level.get_view_entity()
	if e and e:clsid() == clsid.script_actor then
		controlled_actor = e
		use_own_actor_id(e)
	end
	return controlled_actor
end

local function in_game()
	return local_actor() ~= nil
end

-- GAMMA scripts use AC_ID (0, the story Actor) for "the player". On a client
-- the own Actor has another id: AC_ID becomes that id, and db.storage[0]
-- (captured copies of the old constant) reads the own Actor's storage.
use_own_actor_id = function(obj)
	if not obj then return end
	_G.AC_ID = obj:id()
	local storage = db and db.storage
	if type(storage) == "table" and not getmetatable(storage) then
		setmetatable(storage, { __index = function(t, k)
			if k == 0 and controlled_actor then return rawget(t, controlled_actor:id()) end
		end })
	end
end

-- GAMMA's "Busy Hands" handler (callbacks_gameobject) pauses the game with a
-- warning and saves on any failed engine call. A netcoop client has no saves,
-- and such errors come from single-player scripts that do not apply to it;
-- the engine already logs them.
local function quiet_busy_hands()
	_G.COnLuaBindFatalError = function(offender)
		printf("[NetAnomaly] engine call failed in %s", tostring(offender))
	end
end

-- Engine hook (Level_network_spawn.cpp) after the local Actor is assigned.
function on_actor_spawned(obj)
	controlled_actor = obj
	use_own_actor_id(obj)
	quiet_busy_hands()
end

function on_actor_destroyed(obj)
	if controlled_actor and obj and controlled_actor:id() == obj:id() then
		controlled_actor = nil
	end
end

function is_pure_client()
	return native_alife ~= nil and native_alife() == nil and in_game()
end

----------------------------------------------------------------------
-- se_actor stand-in built from the live Actor game object
----------------------------------------------------------------------
local actor_methods = {
	character_name = function() return db.actor:character_name() end,
	community = function() return db.actor:character_community() end,
	rank = function() return db.actor:character_rank() end,
	reputation = function() return db.actor:character_reputation() end,
	character_icon = function() return db.actor:character_icon() end,
	profile_name = function() return db.actor:profile_name() end,
	name = function() return db.actor:name() end,
	section_name = function() return db.actor:section() end,
	clsid = function() return db.actor:clsid() end,
	alive = function() return db.actor:alive() end,
	money = function() return db.actor:money() end,
}

local actor_fields = {
	id = function() return db.actor:id() end,
	parent_id = function() return 65535 end,
	online = function() return true end,
	position = function() return db.actor:position() end,
	m_level_vertex_id = function() return db.actor:level_vertex_id() end,
	m_game_vertex_id = function() return db.actor:game_vertex_id() end,
	group_id = function() return 65535 end,
}

local se_actor_stub = setmetatable({}, {
	__index = function(_, k)
		local field = actor_fields[k]
		if field then return field() end
		local method = actor_methods[k]
		if method then return function() return method() end end
		warn_once("actor():" .. tostring(k))
		return function() return nil end
	end,
})

----------------------------------------------------------------------
-- alife() stand-in
----------------------------------------------------------------------
----------------------------------------------------------------------
-- Admin world changes go to the server (netanomaly_server.script)
----------------------------------------------------------------------
local function is_admin()
	return netcoop_role and netcoop_role() == 2
end

local function request_create(section, pos, lvid, gvid, parent_id)
	if not is_admin() then
		warn_once("create (admin only)")
		return nil
	end
	-- Only the admin's debug spawn menu creates objects from a client. World
	-- scripts that run on game start (stash and loot placement) belong to the
	-- server, which runs them itself.
	local trace = debug and debug.traceback and debug.traceback() or ""
	if not string.find(trace, "ui_debug", 1, true) then
		warn_once("create (only from the admin spawn menu)")
		return nil
	end
	local a = db.actor
	-- GAMMA spawners pass AC_ID (0, the story Actor) for "into my inventory".
	if parent_id and a and (parent_id == a:id() or parent_id == 0) then
		netcoop_command(string.format("spawn %s 1", tostring(section)))
	elseif pos then
		netcoop_command(string.format("spawn_at %s %.2f %.2f %.2f", tostring(section), pos.x, pos.y, pos.z))
	else
		netcoop_command(string.format("spawn %s 1", tostring(section)))
	end
	return nil -- the object arrives later as a normal network spawn
end

local sim_methods = {
	create = function(_, section, pos, lvid, gvid, parent_id) return request_create(section, pos, lvid, gvid, parent_id) end,
	actor = function() return db.actor and se_actor_stub or nil end,
	object = function(_, id) return nil end,
	story_object = function() return nil end,
	object_by_id = function() return nil end,
	has_info = function(_, id, info)
		local a = db.actor
		return a ~= nil and a:has_info(info) or false
	end,
	level_name = function() return level.name() end,
	level_id = function() return 0 end,
	switch_distance = function() return 150 end,
	object_count = function() return 0 end,
	iterate_info = function() end,
	iterate_objects = function() end,
	get_children = function() return {} end,
}

local sim_stub = setmetatable({}, {
	__index = function(_, k)
		local m = sim_methods[k]
		if m then return m end
		return function()
			warn_once(tostring(k))
			return nil
		end
	end,
})

local function alife_compat()
	local sim = native_alife()
	if sim then return sim end
	-- Level scripts (including the Actor binder reinit) run before the Actor
	-- becomes the view entity, so answer as soon as a level is loaded.
	if level and level.present and level.present() then return sim_stub end
	return nil
end

----------------------------------------------------------------------
-- db.actor falls back to the locally controlled Actor
----------------------------------------------------------------------
local function install_db_actor()
	local ns = db
	if type(ns) ~= "table" then return end
	local mt = getmetatable(ns)
	if not mt then
		mt = {}
		setmetatable(ns, mt)
	end
	if mt.__netcoop_actor then return end
	local previous = mt.__index
	mt.__netcoop_actor = true
	mt.__index = function(t, k)
		if k == "actor" then
			if native_alife() == nil then
				return local_actor()
			end
			return nil
		end
		if type(previous) == "function" then return previous(t, k) end
		if type(previous) == "table" then return previous[k] end
		return nil
	end
end

----------------------------------------------------------------------
-- No save games on a client: the server owns the world state
----------------------------------------------------------------------
local function no_saves(flags)
	if flags then flags.ret = true end
	printf("[NetAnomaly] saving and loading are disabled: the server owns the world")
end

local function no_quick_load(dik, bind, flags)
	no_saves(flags)
end

----------------------------------------------------------------------
-- Engine callbacks (netcoop.cpp)
----------------------------------------------------------------------
local function show_text(text)
	local a = db.actor
	if a and text and text ~= "" then
		pcall(function() a:give_game_news("Server", text, "ui_inGame2_PD_Lider", 0, 7000) end)
	end
end

function on_auth_result(ok, role, message)
	printf("[NetAnomaly] login %s: role=%s %s", ok and "ok" or "failed", tostring(role), tostring(message))
	if ok and role == 2 then
		-- The debug launcher registers its keys only in debug mode.
		_G.DEV_DEBUG = true
		-- on_game_start ran before login, while this player had no admin role.
		-- Register the launcher's callbacks now so the spawn menu key works.
		ui_debug_launcher.on_game_start()
	end
end

function on_trade_result(ok, role, message)
	if not ok then show_text(message) end
end

function on_server_text(text)
	show_text(text)
end

----------------------------------------------------------------------
-- World state from the server (netcoop_broadcast on the server)
----------------------------------------------------------------------
local server_weather = nil

-- The server's weather manager chooses the weather; the local one must not.
local function use_server_weather(name)
	if not name or name == "" or name == server_weather then return end
	local first = server_weather == nil
	server_weather = name
	if first and level_weathers and level_weathers.WeatherManager then
		level_weathers.WeatherManager.select_weather = function() end
		level_weathers.WeatherManager.change_period = function() end
	end
	local wm = level_weathers and level_weathers.get_weather_manager()
	if wm then wm.weather_file = name end
	pcall(level.set_weather, name, first)
	printf("[NetAnomaly] server weather: %s", name)
end

function on_script_message(channel, data)
	if channel == "weather" then
		use_server_weather(data)
	end
end

-- Engine (netcoop.cpp) when the task list from the server adds, completes or
-- fails a task. The server's own task news arrive as PDA news.
function on_task(task_id, kind)
	printf("[NetAnomaly] task %s: %s", tostring(task_id), tostring(kind))
end

-- The GAMMA debug menu runs locally for an admin; its world changes are
-- routed to the server through alife():create above and admin commands.
local function install_admin_menu()
	local compat = gamma_net_compat
	if type(compat) ~= "table" then return end
	compat.admin_allowed = function() return is_admin() end
	compat.is_server = function() return is_admin() end
	compat.request_admin = function() return false end
end

-- axr_main calls on_game_start of every script after all scripts are loaded.
-- Admin debug/spawn menu: F7 (GAMMA default) and Num3.
local function admin_menu_key(key)
	if key ~= DIK_keys.DIK_NUMPAD3 or not is_admin() then return end
	local a = db.actor
	if not (a and a:alive()) then return end
	if ui_debug_launcher and ui_debug_launcher.start_debug_main then
		ui_debug_launcher.start_debug_main()
	end
end

-- The emission and psi-storm managers are normally created by the ALife save
-- state load, which a client does not have; level_weathers reads them. A
-- client does not start its own emission: its timer is pushed out of reach
-- until emissions come from the server.
local function init_event_managers()
	for _, m in ipairs({ { surge_manager, "get_surge_manager" }, { psi_storm_manager, "get_psi_storm_manager" } }) do
		local module, getter = m[1], m[2]
		if module and module[getter] then
			local ok, err = pcall(function()
				local mgr = module[getter]()
				if not mgr._state_loaded then
					mgr:initialize()
					mgr._state_loaded = true
				end
				mgr._delta = 1000000000
			end)
			if not ok then printf("[NetAnomaly] %s init failed: %s", getter, tostring(err)) end
		end
	end
end

function on_game_start()
	quiet_busy_hands()
	init_event_managers()
	-- PDA tabs read the simulation board; the simulation itself runs on the
	-- server, so the client keeps an empty board.
	if sim_board and sim_board.get_sim_board then
		local ok, err = pcall(sim_board.get_sim_board)
		if not ok then printf("[NetAnomaly] sim board init failed: %s", tostring(err)) end
	end
	RegisterScriptCallback("on_before_save_input", no_saves)
	RegisterScriptCallback("on_before_load_input", no_quick_load)
	RegisterScriptCallback("on_key_release", admin_menu_key)
end

----------------------------------------------------------------------
-- GAMMA callbacks: one failing handler must not skip the others
----------------------------------------------------------------------
-- axr_main.make_callback calls every handler of a callback in one loop, so a
-- handler that failed (world setup scripts that belong to the other side of
-- the connection) ended the loop and the remaining mods never ran. Handlers
-- are wrapped when registered; the first error of each is logged.
local wrapped_callbacks = {}
local failed_callbacks = {}

local function isolate_callbacks()
	local am = axr_main
	if type(am) ~= "table" or am.__netcoop_isolated or not am.callback_set then return end
	am.__netcoop_isolated = true
	local set, unset = am.callback_set, am.callback_unset
	am.callback_set = function(name, handler)
		if handler == nil then return set(name, handler) end
		local by_name = wrapped_callbacks[name]
		if not by_name then
			by_name = {}
			wrapped_callbacks[name] = by_name
		end
		local wrapper = by_name[handler]
		if not wrapper then
			wrapper = function(...)
				local ok, err
				if type(handler) == "function" then
					ok, err = pcall(handler, ...)
				elseif handler[name] then
					ok, err = pcall(handler[name], handler, ...)
				else
					ok = true
				end
				if not ok and not failed_callbacks[wrapper] then
					failed_callbacks[wrapper] = true
					printf("[NetAnomaly] %s handler failed: %s", tostring(name), tostring(err))
				end
			end
			by_name[handler] = wrapper
		end
		return set(name, wrapper)
	end
	am.callback_unset = function(name, handler)
		local by_name = wrapped_callbacks[name]
		return unset(name, by_name and by_name[handler] or handler)
	end
end

function install()
	if installed then return end
	installed = true
	isolate_callbacks()
	native_alife = _G.alife
	_G.alife = alife_compat
	install_db_actor()
	install_admin_menu()
	printf("[NetAnomaly] netcoop client compatibility layer installed")
end
