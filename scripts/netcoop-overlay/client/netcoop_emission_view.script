-- The server owns phase/damage; GAMMA retains its emission effects and sounds.
local installed, active, sequence = false, false, -1
local received_at, received_elapsed, duration = 0, 0, 222
local engine_start, engine_update, engine_end

function install()
    if installed then return end
    installed = true
    local class = surge_manager.CSurgeManager
    engine_start, engine_update, engine_end = class.start, class.update, class.end_surge
    class.start = function() end -- local timers/admin requests cannot start a second world event
    class.give_surge_hide_task = function() end -- replicated server quest
    for _, name in ipairs({ "kill_objects_at_pos", "kill_crows_at_pos", "kill_actor_at_pos", "kill_all_unhided" }) do
        class[name] = function() end
    end
    class.end_surge = function(self)
        self.started = false -- suppress stock mortality/artefact respawn callbacks
        engine_end(self, false)
        self._delta = 1000000000
    end
    class.update = function(self)
        if not (active and self.started and db.actor and db.actor:alive()) then return end
        local seconds = math.min(duration, received_elapsed + (time_global() - received_at) / 1000)
        local offset = game.CTime()
        offset:setHMSms(0, 0, 0, math.floor(seconds * level.get_time_factor() * 1000))
        self.inited_time = game.get_game_time() - offset
        -- The authority already validates the level; joining late must not skip the event.
        self.first_update = true
        engine_update(self)
    end
end

function reset()
    active, sequence = false, -1
end

function receive(data)
    local id, state, seconds, length = string.match(data or "", "^(%d+)|([01])|([%d%.]+)|(%d+)$")
    id, seconds, length = tonumber(id), tonumber(seconds), tonumber(length)
    if not id or seconds > 223 or length ~= 222 or id < sequence then return end
    install()
    local mgr = surge_manager.get_surge_manager()
    if state == "1" and (id ~= sequence or not active) then
        -- Begin normally at zero, then fast-forward its clock to the shared phase.
        engine_start(mgr, true)
    elseif state == "0" and active then
        mgr:end_surge()
        level.stop_weather_fx()
    end
    sequence, active = id, state == "1"
    received_elapsed, received_at, duration = seconds, time_global(), length
    if active then mgr:update() end
end
