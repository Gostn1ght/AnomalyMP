-- RP wheel after New Way's (owner 2026-10-24): the categories around a dark
-- disc, a category's animations on a second ring with the back arrow in the
-- middle, a gold ring on the slot under the mouse, the name in the middle and
-- an animated preview of the animation under the mouse. Animations, groups,
-- icons and preview timing: configs\netcoop\rp_anims.ltx (New Way's, imported
-- by scripts/tools/import-nw-anims.py). Plain Z is reserved before base-game's
-- actor callbacks.
local MENU_KEY = DIK_keys.DIK_Z
local CX, CY = 512, 384
local WHEEL, RING, SLOT, CENTER = 300, 205, 82, 104 -- radii and slot size in 1024x768 units
local ICONS, ICON_CELL, STOP_ICON, BACK_ICON = "ui\\ui_actor_anims_icons", 128, 0, 63
local PREVIEW_FRAME, PREVIEW_COLUMNS = 64, 32
local wnd

local function plain_z(dik)
    return dik == MENU_KEY and key_state(DIK_keys.DIK_LCONTROL) == 0
        and key_state(DIK_keys.DIK_RCONTROL) == 0 and key_state(DIK_keys.DIK_LSHIFT) == 0
        and key_state(DIK_keys.DIK_RSHIFT) == 0 and key_state(DIK_keys.DIK_LMENU) == 0
        and key_state(DIK_keys.DIK_RMENU) == 0
end

local function tr(text) return game.translate_string(text or "") end

-- The categories in the file's order, each with its animations.
local function load_groups()
    local ini = ini_file("netcoop\\rp_anims.ltx")
    local playable = {}
    for name in string.gmatch(netcoop_rp_list and netcoop_rp_list() or "", "([^=;]+)=[^;]*;") do playable[name] = true end
    local groups, by_name = {}, {}
    if not (ini and ini:section_exist("rp_list")) then return groups end
    for i = 0, ini:line_count("rp_list") - 1 do
        local _, name = ini:r_line("rp_list", i, "", "")
        local section = "rp_" .. tostring(name)
        if playable[name] and ini:section_exist(section) then
            local group = ini:r_string_ex(section, "group") or ""
            local g = by_name[group]
            if not g then
                g = { name = group, icon = nil, anims = {} }
                by_name[group] = g
                groups[#groups + 1] = g
            end
            local a = { name = name, title = ini:r_string_ex(section, "title") or name,
                icon = math.floor(ini:r_float_ex(section, "icon") or STOP_ICON) }
            local preview = ini:r_string_ex(section, "preview")
            if preview then
                local frames, intro, intro_ms, loop_ms = string.match(preview, "(%d+)%s*,%s*(%d+)%s*,%s*(%d+)%s*,%s*(%d+)")
                frames = tonumber(frames)
                if frames and frames > 0 then
                    a.preview = { frames = frames, intro = tonumber(intro), intro_ms = math.max(1, tonumber(intro_ms)),
                        loop_ms = math.max(1, tonumber(loop_ms)) }
                end
            end
            if ini:r_bool_ex(section, "group_icon", false) or not g.icon then g.icon = a.icon end
            g.anims[#g.anims + 1] = a
        end
    end
    return groups
end

local function cell_rect(index)
    local x, y = (index % 8) * ICON_CELL, math.floor(index / 8) * ICON_CELL
    return Frect():set(x, y, x + ICON_CELL, y + ICON_CELL)
end

class "netcoop_rp_wnd" (CUIScriptWnd)

function netcoop_rp_wnd:__init() super()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(false)
    self.xscale = (device().height / device().width) / (768 / 1024)
    self.groups = load_groups()
    self.xml = CScriptXmlInit()
    self.xml:ParseFile("ui_netcoop_rp.xml")
    self.xml:InitStatic("shade", self)
    self:Place(self.xml:InitStatic("wheel", self), CX, CY, 2 * WHEEL)
    self.title = self.xml:InitStatic("cap_title", self)
    self.title:SetWndPos(vector2():set(CX - 200 * self.xscale, CY - WHEEL - 34))
    self.title:SetWndSize(vector2():set(400 * self.xscale, 28))
    -- the slots: as many as the largest ring needs
    local most = #self.groups
    for _, g in ipairs(self.groups) do most = math.max(most, #g.anims) end
    self.slots = {}
    for i = 1, most do
        local s = { back = self.xml:InitStatic("slot", self), hover = self.xml:InitStatic("slot_hover", self),
            icon = self.xml:InitStatic("icon", self) }
        s.icon:InitTexture(ICONS)
        self.slots[i] = s
    end
    self.center_icon = self.xml:InitStatic("icon", self)
    self.center_icon:InitTexture(ICONS)
    self:Place(self.center_icon, CX, CY - 22, 64)
    self.preview = self.xml:InitStatic("preview", self)
    self:Place(self.preview, CX, CY - 22, 120)
    self.caption = self.xml:InitStatic("cap_selected", self)
    self.caption:SetWndPos(vector2():set(CX - (CENTER - 8) * self.xscale, CY + 30))
    self.caption:SetWndSize(vector2():set(2 * (CENTER - 8) * self.xscale, 52))
    self:Open(nil)
end

-- A square static of size (1024x768 units) centred on x, y.
function netcoop_rp_wnd:Place(w, x, y, size)
    w:SetWndPos(vector2():set(x - size / 2 * self.xscale, y - size / 2))
    w:SetWndSize(vector2():set(size * self.xscale, size))
end

-- nil: the categories; a category: its animations.
function netcoop_rp_wnd:Open(group)
    self.group, self.hovered = group, nil
    self.items = group and group.anims or self.groups
    local n = #self.items
    for i, s in ipairs(self.slots) do
        local item = self.items[i]
        local shown = item ~= nil
        if shown then
            local angle = -math.pi / 2 + (i - 1) * 2 * math.pi / n
            local x, y = CX + RING * math.cos(angle) * self.xscale, CY + RING * math.sin(angle)
            self:Place(s.back, x, y, SLOT)
            self:Place(s.hover, x, y, SLOT + 10)
            self:Place(s.icon, x, y, SLOT - 12)
            s.icon:SetTextureRect(cell_rect(item.icon))
        end
        s.back:Show(shown); s.icon:Show(shown); s.hover:Show(false)
    end
    self.center_icon:SetTextureRect(cell_rect(group and BACK_ICON or STOP_ICON))
    self.title:TextControl():SetText(group and tr(group.name) or tr("st_netcoop_rp_title"))
    self:Hover(nil)
end

function netcoop_rp_wnd:Hover(index)
    if index == self.hovered and self.hover_set then return end
    self.hover_set = true
    if self.hovered and self.slots[self.hovered] then self.slots[self.hovered].hover:Show(false) end
    self.hovered = index
    local item = index and index > 0 and self.items[index]
    if item then self.slots[index].hover:Show(true) end
    -- the middle: the preview of the animation under the mouse, else the button
    local preview = self.group and item and item.preview
    self.preview_anim, self.preview_start = preview and item or nil, time_global()
    if preview then self.preview:InitTexture("ui\\anim_preview\\anim_" .. item.icon) end
    self.preview:Show(preview ~= nil)
    self.center_icon:Show(preview == nil)
    local text
    if item then text = tr(self.group and item.title or item.name)
    elseif index == 0 then text = tr(self.group and "st_netcoop_rp_back" or "st_netcoop_rp_stop")
    elseif self.group then text = string.format("%s (%d)", tr(self.group.name), #self.group.anims)
    else
        local active = netcoop_rp_active and netcoop_rp_active() or ""
        text = active ~= "" and tr("st_netcoop_rp_stop") or tr("st_netcoop_rp_select")
    end
    self.caption:TextControl():SetText(text)
end

-- The preview's frame: the intro once, then the loop.
function netcoop_rp_wnd:PreviewFrame()
    local p = self.preview_anim and self.preview_anim.preview
    if not p then return end
    local t = time_global() - self.preview_start
    local intro_time = p.intro * p.intro_ms
    local frame
    if t < intro_time then
        frame = math.floor(t / p.intro_ms)
    else
        local loop = math.max(1, p.frames - p.intro)
        frame = p.intro + math.floor((t - intro_time) / p.loop_ms) % loop
    end
    local x, y = (frame % PREVIEW_COLUMNS) * PREVIEW_FRAME, math.floor(frame / PREVIEW_COLUMNS) * PREVIEW_FRAME
    self.preview:SetTextureRect(Frect():set(x, y, x + PREVIEW_FRAME, y + PREVIEW_FRAME))
end

function netcoop_rp_wnd:Update()
    CUIScriptWnd.Update(self)
    local p = GetCursorPosition()
    local dx, dy = (p.x - CX) / self.xscale, p.y - CY
    local radius = math.sqrt(dx * dx + dy * dy)
    local index
    if radius <= CENTER then
        index = 0
    elseif radius <= WHEEL and #self.items > 0 then
        local n = #self.items
        local angle = (math.atan2(dy, dx) + math.pi / 2 + math.pi / n) % (2 * math.pi)
        index = math.floor(angle * n / (2 * math.pi)) + 1
    end
    self:Hover(index)
    self:PreviewFrame()
end

function netcoop_rp_wnd:Close()
    if self:IsShown() then self:HideDialog() end
end

function netcoop_rp_wnd:Click()
    local index = self.hovered
    if index == 0 then
        if self.group then self:Open(nil) return end
        if netcoop_rp_stop then netcoop_rp_stop() end
        self:Close()
        return
    end
    local item = index and self.items[index]
    if not item then return end
    if not self.group then self:Open(item) return end
    -- a weapon pose without the weapon does not start
    if netcoop_rp_play and not netcoop_rp_play(item.name) and actor_menu then
        actor_menu.set_msg(1, tr("st_netcoop_rp_need_weapon"), 3)
    end
    self:Close()
end

function netcoop_rp_wnd:OnKeyboard(dik, action)
    if action == ui_events.WINDOW_KEY_PRESSED then
        if dik == DIK_keys.DIK_ESCAPE or dik == MENU_KEY then
            self:Close()
            return true
        end
        if dik == DIK_keys.MOUSE_2 then
            if self.group then self:Open(nil) else self:Close() end
            return true
        end
        if dik == DIK_keys.MOUSE_1 then
            self:Click()
            return true
        end
    end
    return CUIScriptWnd.OnKeyboard(self, dik, action)
end

function toggle()
    if not (db.actor and db.actor:alive() and netcoop_rp_list) then return end
    if wnd and wnd:IsShown() then wnd:Close(); return end
    if not actor_menu.is_hud_free() then return end
    if not wnd then wnd = netcoop_rp_wnd() end
    wnd:Open(nil)
    wnd:ShowDialog(true)
end

local function on_before_key_press(dik, bind, disabled, flags)
    if not plain_z(dik) or disabled then return end
    if (wnd and wnd:IsShown()) or actor_menu.is_hud_free() then
        toggle()
        flags.ret_value = false
    end
end

local function consume_z(dik, bind, disabled, flags)
    if plain_z(dik) then flags.ret_value = false end
end

-- Called by the engine before other mods receive the key.
function consume_key(dik)
    if dik ~= MENU_KEY then return false end
    toggle()
    return true
end

local function on_destroy()
    if wnd then wnd:Close() end
    wnd = nil
end

function on_game_start()
    if netcoop_pure_client and netcoop_pure_client() then
        RegisterScriptCallback("on_before_key_press", on_before_key_press)
        RegisterScriptCallback("on_before_key_release", consume_z)
        RegisterScriptCallback("on_before_key_hold", consume_z)
        RegisterScriptCallback("actor_on_net_destroy", on_destroy)
    end
end
