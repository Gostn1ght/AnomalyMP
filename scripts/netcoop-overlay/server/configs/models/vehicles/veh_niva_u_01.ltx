;-- ;physics\vehicles\niva\veh_niva_u_01.ogf (vehicle_niva_green)
;-- ;physics\vehicles\niva\veh_niva_u_02.ogf (vehicle_niva_white)
;-- Нива 2121 Definitive Car Pack
;-- Переработка и настройка: Videoton

[disable]
linear_factor		= 0.3
angular_factor		= 0.3

;-------------------------------------------------------------------------------
;-------------------------------------------------------------------------------

[car_definition]
character_scraper
time_to_explosion			= 0 ;-- time to explode when damaged (ms)
camera_pos					= -0.402, 1.46, 0.03 ;skyloader: DOESNT USED

camera_pos_firsteye			= -0.402, 1.46, 0.03
camera_pos_lookat			= 0.0, 1.74, -0.1
;camera_pos_free				= 0.0, 1.24, -0.1
camera_pos_free				= 0.0, 1.84, -0.3

driving_wheels				= back_left_wheel, back_right_wheel, front_left_wheel, front_right_wheel ;-- driving wheels
steering_wheels				= front_left_wheel, front_right_wheel ;-- steering wheels
breaking_wheels				= front_left_wheel, front_right_wheel, back_left_wheel, back_right_wheel ;-- breaking wheels
doors						= left_door, right_door ;-- vehicle doors (entrance)
steer						= stearing_wheel ;-- stearing wheel
driver_place				= seat_left ;-- driver's seat
exhausts					= exhausts ;-- exhaust pipe
;exhaust_particles			= vehiclefx\exhaust_1 ;-- particle for exhaust pipe
damage						= damage_bones ;-- bones damage coeffs
trunk_bone 					= back_door; trunk_box
nitro						= true
nitro_power_factor			= 1.2
nitro_fuel_factor			= 1.4
nitro_particles_enabled		= false

collision_hit_threshold = 0.2 ; [LA DC] minimum physical collision damage to be applied to car (vanilla is 5.0)

;-------------------------------------------------------------------------------
;------ Factory parameters of Engine -------------------------------------------

fuel_tank         		= 50			;-- litres
fuel_consumption  		= 0				;-- liters per 100 000 rotations
engine_power      		= 10.2				;-- horse_power (kW = hp * 0.808)
max_power_rpm     		= 4300		;-- on this rpm value engine power reaches maximum
max_torque_rpm    		= 2900		;-- on this rpm engine torque reaches maximum

power_increment_factor	= 0.011	;-- power increment coeff
power_decrement_factor	= 0.08		;-- power decrement coeff
rpm_increment_factor	= 0.07		;-- rpm increment coeff
rpm_decrement_factor	= 0.2		;-- power decrement coeff
m_power_neutral_factor	= 0.25	;-- ???

max_engine_rpm    		= 5000	;-- max rpm
idling_engine_rpm		= 900		;-- min rpm

;-------------------------------------------------------------------------------
;------ Adjustment a wheel -----------------------------------------------------

reference_radius  		= 0.35		;-- radius of the wheel used in engine failures
axle_friction     		= 3			;-- reducing the speed neutral position (N * m)
steering_speed    		= 0.86			;-- time-turn the steering wheel, the maximum: rps(1)
steering_torque   		= 100000			;-- strength of power steering (N * m)
break_torque      		= 0.012		;-- strength of brake pads (N * m)
break_time        		= 0.9			;-- rise time to the maximum braking force
hand_break_torque 		= 0.012		;-- braking force space (default = break_torque)

;-------------------------------------------------------------------------------
;------ Gearbox ----------------------------------------------------------------

main_gear_ratio    		= 13.3		;-- main ratio
auto_transmission  		= on			;-- automatic gear (on/off); when off use shift up/down to change gear

[transmission_gear_ratio]
;-- shift down / shift up (rpm, needed to switch)
R	= 3.60, 1925, 4600	
N1	= 3.60, 1925, 4600
N2	= 1.87, 1925, 4600
N3	= 1.11, 2050, 4600
N4	= 0.72, 2175, 4600

;-------------------------------------------------------------------------------
;------ Rest Adjustment --------------------------------------------------------

[lights]
headlights         		= f1, f2

[f1]
bone               		= left_light
color              		= 1.24,1.2,1.15,1
range              		= 40
cone_angle         		= 53
spot_texture       		= lights\lights_bspot01_cv
glow_texture       		= glow\glow_Yellow
glow_radius        		= 0.9
volumetric 				= true
volumetric_distance 	= 10
volumetric_intensity 	= 10
volumetric_quality 		= 10

[f2]
bone               		= right_light
color              		= 1.24,1.2,1.15,1
range              		= 40
cone_angle         		= 53
spot_texture       		= lights\lights_bspot01_cv
glow_texture       		= glow\glow_Yellow
glow_radius        		= 0.9
volumetric 				= true
volumetric_distance 	= 10
volumetric_intensity 	= 10
volumetric_quality 		= 10

[car_sound]
snd_volume         				= 1.0
snd_name           				= car\niva_engine_run
engine_sound_start_dellay		= 0.25
engine_start					= car\o_car2_start
engine_stop						= car\o_car2_stop
transmission_switch				= car\o_car_gear
explosion_sound    				= 
relative_pos       				= -0.1, 0.5, 1.55

;-------------------------------------------------------------------------------
;------ animations params ------------------------------------------------------

[doors]
open_torque_factor		= 5		;-- delay for opening the door (default = 2)

[animations]
driver_animation_type	= 3

;-------------------------------------------------------------------------------
;------ damage params ----------------------------------------------------------

[damage_particles]
explosion_particles				= explosions\expl_car
car_damage_particles1			= explosions\expl_car_smoke_small
car_damage_particles2			= explosions\expl_car_smoke_big
wheels_damage_particles1	= vehiclefx\exhaust_1
wheels_damage_particles2	= vehiclefx\exhaust_1

particle_bones1		= front_bamper
particle_bones2		= root

;-------------------------------------------------------------------------------
;------ particle bones ---------------------------------------------------------

[particle_bones]
root					= 0, -0.75, 1.75
front_bamper			= 0, 0, -0.5

;-------------------------------------------------------------------------------
;------ damage items -----------------------------------------------------------

[damage_items]
back_left_wheel   		= 0
back_right_wheel  		= 0
front_left_wheel  		= 0
front_right_wheel 		= 0
left_door         		= 0
right_door        		= 0
back_door				= 0

;-------------------------------------------------------------------------------
;------ collisiondamage --------------------------------------------------------

[collision_damage]
root					= 0.0001
front_bamper			= 0.0001
kabina					= 0.0001
back_door				= 0.00008
back_left_wheel			= 0.00001
back_right_wheel		= 0.00001
front_left_wheel		= 0.00001
front_right_wheel		= 0.00001

;-------------------------------------------------------------------------------
;------ damage bones -----------------------------------------------------------

[damage_bones]
;bone_name     			= <hit_scale>,<-1>,<wound_scale>
;<hit_scale>				- coeff, reduce health
;<wound_scale> 			- coeff, wounds

default       			= 1, -1, 0.1

[immunities]
;-- 0.0 => 100% invulnerable
;-- 1.0 => 100% vulnerable
burn_immunity         	= 0.13		;-- burn (fire)
strike_immunity       	= 0.016	;-- strike (collision with objects) => collision_damage
shock_immunity        	= 0.08	;-- shock (anom)
wound_immunity        	= 0.0		;-- wound
radiation_immunity    	= 0.0		;-- radiation
telepatic_immunity    	= 0.0		;-- telepathy
chemical_burn_immunity 	= 0.08	;-- chemical burn (anom)
explosion_immunity    	= 0.17		;-- explosion
fire_wound_immunity   	= 0.017	;-- bullets hits

;-------------------------------------------------------------------------------
;----------------explosion params-----------------------------------------------

[explosion]
blast					= 1
blast_r					= 15
blast_impulse			= 350
frags		        	= 15
frags_r					= 30
frag_hit				= 0.5
frag_hit_impulse		= 350
hit_type_blast			= explosion
hit_type_frag			= fire_wound
up_throw_factor			= 0.25
wm_size            		= 0.1
explode_particles		= explosions\expl_car
light_color				= 0.6, 0.5, 0.3
light_range				= 15.0
light_time 				= 0.5

fragment_speed			= 76
fragment_tracer_max_length	= 3
explode_duration    	= 50

snd_explode 			= weapons\heli_explosion
wallmark_section	= explosion_marks

[explode_effector]
effect_sect_name = effector_explode_hit ;-- misc\postprocess.ltx

