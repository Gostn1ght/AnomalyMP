fuel_consumption  		= 0		       	; L / (100k R); liters per 100 000 rotations
engine_power      		= 18        	; horse_power (kW=hp*0.808) max power
max_power_rpm     		= 3700        	; (nominal rpm ) on this rpm value engine power reaches maximum
max_torque_rpm    		= 800       	; on this rpm engine torque reaches maximum

power_increment_factor	= 0.01
