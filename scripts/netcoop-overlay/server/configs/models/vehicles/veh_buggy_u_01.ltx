[car_definition]
character_scraper
time_to_explosion			= 0 ;-- time to explode when damaged (ms)
camera_pos        			= -0.22, 1.285, -0.325
	
camera_pos_firsteye			= -0.22, 1.285, -0.325
camera_pos_lookat			= 0.0, 1.67, -0.31
camera_pos_free				= 0.0, 1.77, -0.51
