;exhaust_particles			= vehiclefx\exhaust_1
damage						= damage_bones
trunk_bone					= trunk
nitro						= true
nitro_power_factor			= 1.2
nitro_fuel_factor			= 1.4
nitro_particles_enabled		= false

collision_hit_threshold = 0.2 ; [LA DC] minimum physical collision damage to be applied to car (vanilla is 5.0)

;-------------------------------------------------------------------------------
;------ Factory parameters of Engine -------------------------------------------

fuel_tank					= 30 ;40		; L
fuel_consumption  			= 0 ;6		; L / (100k R); liters per 100 000 rotations
engine_power				= 9.6 		; horse_power (kW=hp*0.808) max power
max_power_rpm				= 4000		; (nominal rpm ) on this rpm value engine power reaches maximum, must be within every diapason 	- shift down/ shift up
max_torque_rpm				= 2500		; on this rpm engine torque reaches maximum

power_increment_factor		= 0.01
power_decrement_factor		= 0.07
rpm_increment_factor		= 0.07
rpm_decrement_factor		= 0.2
m_power_neutral_factor		= 0.75

; additional engine parameters

max_engine_rpm			= 5000		; rpm (5000) rpm will never be more
idling_engine_rpm		= 900       	; rpm (750) min rpm - starts from this rpm value

;-------------------------------------------------------------------------------
;------ Adjustment a wheel -----------------------------------------------------

reference_radius		= 0.44			; Радиус колеса, используемый при просчёте двигателя
axle_friction			= 2	  		; Ослабление скорости в неетральной позиции. (N*m)
steering_speed			= 0.92         	; Время поворота рулевого колеса, в максимум. rps (1)
steering_torque			= 100000    		; Сила гидроусилителя руля. (N*m)
break_torque			= 0.06        	; Сила тормозных колодок. (N*m)
break_time				= 0.8         	; время нарастания силы торможения до максимума, при подтормаживании (стрелка назад)
hand_break_torque		= 0.055        	; сила торможения пробелом (по умолчанию = break_torque)

