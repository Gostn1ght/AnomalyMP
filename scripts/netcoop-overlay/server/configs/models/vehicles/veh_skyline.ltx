;-- Конвертрация в сталкер: Videoton
;-- Модель из GRID, автор рипа DMN

[disable]
linear_factor				= 0.3
angular_factor				= 0.3

;-------------------------------------------------------------------------------

[car_free_cam]
apply_inert             	= false
lim_zoom                	= 1.3, 8.5
	
[car_look_cam]	
apply_inert             	= false
lim_zoom                	= 1.3, 8.5
	
[car_definition]
character_scraper	
time_to_explosion			= 0 ;-- time to explode when damaged (ms)
camera_pos					= 0.415, 1.31, 0.26
	
camera_pos_firsteye			= 0.415, 1.31, 0.26
;camera_pos_lookat			= 0.0, 1.6, -0.48
;camera_pos_free				= 0.0, 1.7, -0.68
camera_pos_lookat			= 0.0, 1.67, -0.1
camera_pos_free				= 0.0, 1.63, -0.1
	
camera_inertion_n 			= 0.98
camera_inertion_k 			= -0.99
	
driving_wheels				= front_left_wheel, front_right_wheel, back_left_wheel, back_right_wheel ;-- driving wheels
steering_wheels				= front_left_wheel, front_right_wheel ;-- steering wheels
breaking_wheels				= front_left_wheel, front_right_wheel, back_left_wheel, back_right_wheel ;-- breaking wheels
doors						= left_door, right_door, front_door ;-- vehicle doors (entrance)
