driver_place				= seat_right ;-- driver's seat
exhausts					= exhausts ;-- exhaust pipe
;exhaust_particles 			= tests\_flame_burst_01
;pop_particles				= weapons\generic_weapon01
pop_probability				= 0.2
damage						= damage_bones ;-- bones damage coeffs
trunk_bone 					= back_door;
nitro						= true
nitro_power_factor			= 10
nitro_fuel_factor			= 2
	
collision_hit_threshold 	= 0.3 ; [LA DC] minimum physical collision damage to be applied to car (vanilla is 5.0)

;-------------------------------------------------------------------------------
;------ Factory parameters of Engine -------------------------------------------

fuel_tank         			= 65		;-- litres
fuel_consumption  			= 0			;-- liters per 100 000 rotations
engine_power      			= 70		;-- horse_power (kW = hp * 0.808)
max_power_rpm     			= 3900 ;4450		;-- on this rpm value engine power reaches maximum
max_torque_rpm    			= 1700 ;3050		;-- on this rpm engine torque reaches maximum	
sound_rpm					= 3500 ;3150
	
power_increment_factor		= 0.009 ;15	 ;-- power increment coeff
power_decrement_factor		= 0.27 ;0.08 ;-- power decrement coeff
rpm_increment_factor		= 0.14		 ;-- rpm increment coeff
rpm_decrement_factor		= 0.28		 ;-- power decrement coeff
power_neutral_factor		= 0.08	     ;-- ???
	
max_engine_rpm    			= 5000	;-- max rpm
idling_engine_rpm			= 900	;-- min rpm

;-------------------------------------------------------------------------------
;------ Adjustment a wheel -----------------------------------------------------

reference_radius  			= 0.35	        ;-- radius of the wheel used in engine failures
axle_friction     			= 5			;-- reducing the speed neutral position (N * m)
steering_speed    			= 1.0		    ;-- time-turn the steering wheel, the maximum: rps(1)
steering_torque   			= 100000			;-- strength of power steering (N * m)
break_torque      			= 0.3           ;-- strength of brake pads (N * m)
break_time        			= 0.6			;-- rise time to the maximum braking force
hand_break_torque 			= 0.2  	        ;-- braking force space (default = break_torque)
steer_nonlinear				= true
steer_invert				= false
break_abs					= true
;break_abs_power		    	= 1

;-------------------------------------------------------------------------------
;------ Gearbox ----------------------------------------------------------------

main_gear_ratio    			= 3.5;4.2		    ;-- main ratio
auto_transmission  			= on			;-- automatic gear (on/off); when off use shift up/down to change gear
transmission_switch_delay 	= 0.3
;transmission_switch_power 	= 0.5
;transmission_switch_volume 	= 1.0
transmission_clutch_factor 	= 1.3
;transmission_clutch_time 	= 0.5
;transmission_type			= 0

[transmission_gear_ratio]
;-- shift down / shift up (rpm, needed to switch)
R	= 3.47,  2050, 4850
N1	= 3.47,  2050, 4850, 35
N2 	= 1.94,  2050, 4850, 65
N3 	= 1.30,  2175, 4850, 90
N4 	= 0.95,  2300, 4850
N5 	= 0.73,  2425, 4850
N6	= 0.58,  2550, 4850
N7  = 0.47,  2675, 4850
N8	= 0.40,  2800, 4850

