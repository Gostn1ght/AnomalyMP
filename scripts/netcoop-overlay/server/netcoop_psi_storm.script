-- Psi storms for every player, from the server (GAMMA's psi_storm_manager).
--
-- Before: the server pushed the psi-storm timer out of reach and no client
-- ran one, so there were no psi storms online at all. GAMMA's storm, as in
-- freeplay: 103 real seconds at time factor 10; weather at 0 s, siren and
-- rockets at 10 s, the "hide" task at 12 s; from 30 to 77 s a vortex forms
-- every 8-16 s within 150 m of the player and strikes 20 s later: psi
-- (up to 200 m) and shock (up to 50 m) on a player outside a shelter, and
-- death (or the zombie/explode fate of the options) to stalkers within 50 m
-- outside covers and surge smarts - not monolith, zombied or story NPCs.
--
-- Here the server owns the schedule, the vortices and every hit; clients
-- (netcoop_psi_view) show GAMMA's weather, siren, vortex particles/sound and
-- the hit screen effects. Each player gets vortices near himself; players
-- together share them (no vortex within 100 m of one younger than 8 s).
-- Location cluster: one shared schedule like the emission's, never within
-- two game hours of an emission; an emission that starts ends the storm
-- (GAMMA skips the storm then). Restart during a storm resumes its phase.

local installed = false
local sequence, started_at, normal_factor = 0, nil, nil
local next_send = 0
local duration = 103
local vortexes, vortex_seq = {}, 0
local players = {}

local VORTEX_MIN, VORTEX_MAX, VORTEX_DIST = 8, 16, 150
local SHARE_DIST = 100
local PSI_HIT_DIST, ELECTRO_HIT_DIST, NPC_HIT_DIST, CROW_HIT_DIST = 200, 50, 50, 25
local EMISSION_GAP = 2 -- game hours

local function manager() return psi_storm_manager.get_psi_storm_manager() end
local function elapsed() return started_at and math.max(0, (time_global() - started_at) / 1000) or 0 end
local function enabled() return ui_options.get("alife/event/psi_storm_state") end
local function distance_2d(a, b)
	local dx, dz = a.x - b.x, a.z - b.z
	return math.sqrt(dx * dx + dz * dz)
end

local function game_hours()
	local base = game.CTime()
	if base.set then base:set(2012, 1, 1, 0, 0, 0, 0) end
	return game.get_game_time():diffSec(base) / 3600
end
local function frequency_hours()
	return math.max(1, math.floor(tonumber(ui_options.get("alife/event/psi_storm_frequency")) or 24))
end
local function emission_frequency()
	return math.max(1, math.floor(tonumber(ui_options.get("alife/event/emission_frequency")) or 24))
end

-- Start (game hours) of this slot's storm, moved out of the emission's way
-- (inside its own slot); nil when the slot has no room for it.
function scheduled_start(hours, frequency)
	local slot = math.floor(hours / frequency)
	local at = slot * frequency + ((slot * 2246822519 + 374761393) % 4294967296) / 4294967296 * frequency
	local emission = netcoop_emission and netcoop_emission.scheduled_start
	if emission then
		local ef = emission_frequency()
		local function clash(t)
			for _, h in ipairs({ t - ef, t, t + ef }) do
				local e = emission(h, ef)
				if math.abs(t - e) < EMISSION_GAP then return true end
			end
			return false
		end
		if clash(at) then
			local later, earlier = at + EMISSION_GAP + 1, at - EMISSION_GAP - 1
			if later < (slot + 1) * frequency and not clash(later) then at = later
			elseif earlier >= slot * frequency and not clash(earlier) then at = earlier
			else return nil, slot end
		end
	end
	return at, slot
end

local function cluster_due()
	local hours, frequency = game_hours(), frequency_hours()
	local at, slot = scheduled_start(hours, frequency)
	if not at or hours < at then return false end
	local state = alife_storage_manager.get_state()
	local span = duration * 10 / 3600
	if state.netcoop_psi_slot == slot then
		if state.netcoop_psi_done ~= slot and hours - at < span then
			return true, (hours - at) * 3600 / 10
		end
		return false
	end
	if hours - at > 0.5 then return false end
	state.netcoop_psi_slot = slot
	return true, 0
end

-- A single server: GAMMA's own interval (half to full frequency).
local function single_due()
	local state = alife_storage_manager.get_state()
	local hours = game_hours()
	if not state.netcoop_psi_next then
		local f = frequency_hours()
		state.netcoop_psi_next = hours + math.random(math.floor(f / 2) * 3600, f * 3600) / 3600
	end
	return hours >= state.netcoop_psi_next
end

local function payload()
	return string.format("%d|%d|%.3f|%d", sequence, started_at and 1 or 0, elapsed(), duration)
end

-- Seconds into the running storm, -1 when none.
function current_elapsed() return started_at and elapsed() or -1 end

function start(elapsed_seconds)
	install()
	if started_at or not enabled() then return false end
	if not (netcoop_emission and netcoop_emission.is_valid_level()) then return false end
	if netcoop_emission.current_elapsed() >= 0 then return false end
	sequence = sequence + 1
	started_at = time_global() - math.floor((elapsed_seconds or 0) * 1000)
	normal_factor = level.get_time_factor()
	vortexes, players = {}, {}
	local mgr = manager()
	mgr.started, mgr.finished = true, false
	mgr.inited_time = game.get_game_time()
	level.set_time_factor(10)
	SetEvent("psi_storm", "state", true)
	SendScriptCallback("actor_on_interaction", "anomalies", nil, "psi_storm_start")
	netcoop_broadcast("psi_storm", payload())
	next_send = time_global() + 1000
	printf("[Lost Zone] psi storm started: %s", sequence)
	return true
end

function finish()
	if not started_at then return false end
	started_at = nil
	vortexes = {}
	local mgr = manager()
	mgr.started, mgr.finished = false, true
	mgr.last_psi_storm_time = game.get_game_time()
	local state = alife_storage_manager.get_state()
	if state.netcoop_psi_slot then state.netcoop_psi_done = state.netcoop_psi_slot end
	state.netcoop_psi_next = nil
	level.set_time_factor(normal_factor or 6)
	SetEvent("psi_storm", "state", false)
	SendScriptCallback("actor_on_interaction", "anomalies", nil, "psi_storms")
	SendScriptCallback("actor_on_interaction", "anomalies", nil, "psi_storm_end")
	netcoop_broadcast("psi_storm", payload())
	next_send = time_global() + 1000
	printf("[Lost Zone] psi storm finished: %s", sequence)
	return true
end

function install()
	if installed then return end
	installed = true
	-- The stock manager never runs on the server (no Actor binder loop);
	-- its started/finished flags are what other GAMMA scripts read.
	local mgr = manager()
	mgr.update = function() end
	mgr.start = function() return start() end
	mgr.finish = function() return finish() end
	mgr.skip_psi_storm = function() return finish() end
	mgr.started, mgr.finished = false, true
end

local function vortex_payload(id, v)
	return string.format("%d|%d|%.1f|%.1f|%.1f|%.1f", sequence, id, v.x, v.y, v.z, elapsed() - v.at)
end

local function shared(pos, t)
	for _, v in pairs(vortexes) do
		if t - v.at < VORTEX_MIN and distance_2d(v, pos) < SHARE_DIST then return true end
	end
	return false
end

local function spawn_vortex(pos, t)
	local angle = math.rad(math.random(0, 359))
	local distance = math.random(0, VORTEX_DIST)
	vortex_seq = vortex_seq + 1
	local v = { x = pos.x + math.cos(angle) * distance, y = pos.y, z = pos.z + math.sin(angle) * distance, at = t }
	vortexes[vortex_seq] = v
	netcoop_broadcast("psi_vortex", vortex_payload(vortex_seq, v))
	return v
end

-- Stalkers and crows at a vortex (GAMMA's kill_objects_at_pos without the
-- single-player Actor checks); clients show the electrocution.
local function strike_world(v)
	local pos = vector():set(v.x, v.y, v.z)
	local mgr = manager()
	if mgr.kill_crows_at_pos then pcall(mgr.kill_crows_at_pos, mgr, pos) end
	local fate = ui_options.get("alife/event/psi_storm_fate")
	if fate == "unhurt" then return end
	local sm, board, sim = surge_manager.get_surge_manager(), SIMBOARD, alife()
	local killed = {}
	for _, id in ipairs(db.OnlineStalkers or {}) do
		local npc = db.storage[id] and db.storage[id].object or level.object_by_id(id)
		local comm = npc and npc:character_community()
		local npc_pos = npc and npc:position()
		if npc_pos and IsStalker(npc) and npc:alive() and comm ~= "monolith" and comm ~= "zombied"
			and not get_object_story_id(id) and distance_2d(pos, npc_pos) < NPC_HIT_DIST then
			local se_npc = sim:object(id)
			local squad = se_npc and se_npc.group_id and sim:object(se_npc.group_id)
			if squad then
				local smart = board and squad.smart_id and board.smarts[squad.smart_id] and board.smarts[squad.smart_id].smrt
				local surge_smart = smart and smart.props and (tonumber(smart.props["surge"]) or 0) > 0
				if not (surge_smart or sm:pos_in_cover(npc_pos)) then
					killed[#killed + 1] = string.format("%.1f %.1f %.1f", npc_pos.x, npc_pos.y, npc_pos.z)
					if fate == "turn_to_zombie" then sm:turn_to_zombie(se_npc, squad)
					elseif fate == "explode" then sm:explode(se_npc, squad)
					else npc:kill(npc) end
				end
			end
		end
	end
	if #killed > 0 then netcoop_broadcast("psi_kill", table.concat(killed, ";")) end
end

-- GAMMA's vortex_actor_hit for one player (db.actor is that player here).
local function strike_player(actor, v)
	if netcoop_emission.player_cover(actor) then return end
	if netcoop_admin_god_enabled and netcoop_admin_god_enabled(actor:id()) then return end
	local d = distance_2d(actor:position(), v)
	if d >= PSI_HIT_DIST then return end
	local sm = surge_manager.get_surge_manager()
	-- Drug protection is cached by the single-player manager; clear it between owners.
	sm.drug_telepatic_protection, sm.drug_radiation_protection, sm.drug_chemical_burn_protection = nil, nil, nil
	local immune = level_environment and level_environment.is_actor_immune and level_environment.is_actor_immune()
	local helmet = dialogs_yantar and dialogs_yantar.actor_has_psi_helmet and dialogs_yantar.actor_has_psi_helmet()
	local function strike(kind, power)
		local h = hit()
		h.type, h.impulse, h.direction, h.draftsman = kind, 0, VEC_Z, actor
		h.power = power
		actor:hit(h)
		return power
	end
	local psi = strike(hit.telepatic, (immune or helmet) and 0 or sm:hit_power(math.cos(d * math.pi / PSI_HIT_DIST) + 1, hit.telepatic))
	local shock = -1
	if d < ELECTRO_HIT_DIST then
		shock = strike(hit.shock, immune and 0 or sm:hit_power(math.cos(d * math.pi / ELECTRO_HIT_DIST) + 1, hit.shock))
	end
	netcoop_send_to_actor(actor:id(), "psi_hit", string.format("%.3f %.3f", psi, shock))
end

function update_world()
	install()
	if not started_at then
		if enabled() and netcoop_emission and netcoop_emission.is_valid_level() and netcoop_emission.current_elapsed() < 0 then
			if netcoop_emission.cluster_mode() then
				local due, at = cluster_due()
				if due then start(at) end
			elseif single_due() then
				start()
			end
		end
	elseif netcoop_emission.current_elapsed() >= 0 or elapsed() >= duration then
		finish()
	else
		local t = elapsed()
		for id, v in pairs(vortexes) do
			if not v.struck and t - v.at >= 20 then
				v.struck = true
				local ok, err = pcall(strike_world, v)
				if not ok then printf("[Lost Zone] psi storm strike error: %s", tostring(err)) end
			end
			if t - v.at >= 25 then vortexes[id] = nil end
		end
	end
	if time_global() >= next_send then
		next_send = time_global() + 1000
		netcoop_broadcast("psi_storm", payload())
	end
end

-- Every 0.5 s for each player, db.actor bound to him.
function update_player(actor)
	if not started_at then return end
	local id, t = actor:id(), elapsed()
	local own = players[id]
	if not own then
		-- A late joiner sees the storm and the living vortices, and is not
		-- struck by those that already struck.
		own = { hit = {} }
		players[id] = own
		netcoop_send_to_actor(id, "psi_storm", payload())
		for vid, v in pairs(vortexes) do
			if t - v.at >= 20 then own.hit[vid] = true end
			netcoop_send_to_actor(id, "psi_vortex", vortex_payload(vid, v))
		end
	end
	if t >= 12 and not own.task then
		own.task = true
		if ui_options.get("alife/event/psi_storm_task") then
			task_manager.get_task_manager():give_task("hide_from_psi_storm")
		end
	end
	if not actor:alive() then return end
	if t >= 30 and t <= 77 then
		own.next = own.next or (t + math.random(VORTEX_MIN, VORTEX_MAX))
		if t >= own.next then
			own.next = t + math.random(VORTEX_MIN, VORTEX_MAX)
			if not shared(actor:position(), t) then spawn_vortex(actor:position(), t) end
		end
	end
	for vid, v in pairs(vortexes) do
		if not own.hit[vid] and t - v.at >= 20 then
			own.hit[vid] = true
			strike_player(actor, v)
		end
	end
end
