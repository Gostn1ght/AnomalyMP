-- One authority for the emission clock, damage, quests and artefact respawn.
-- Visual/sound effects use base-game's manager on the clients.
local installed = false
local sequence, started_at, normal_factor = 0, nil, nil
local next_send, players = 0, {}
local duration = 222

local function manager() return surge_manager.get_surge_manager() end
local function elapsed() return started_at and math.max(0, (time_global() - started_at) / 1000) or 0 end
-- GAMMA fills level_weathers.valid_levels (surface maps: emissions, psi
-- storms, campfires) when its weather manager resets for the Actor, which
-- never happens on the dedicated server: the table stayed empty and no
-- emission or psi storm ever started there (2026-10-06). Same rule, here.
local function ensure_valid_levels()
    local valid = level_weathers and level_weathers.valid_levels
    if not valid or next(valid) then return end
    local gini = game_ini()
    for _, name in ipairs(utils_data.collect_section(gini, "level_maps_single")) do
        if gini:r_string_ex(name, "weathers") == "atmosfear" then valid[name] = true end
    end
end
local function valid_level()
    ensure_valid_levels()
    local name = level.name()
    return level_weathers.valid_levels[name] == true and name ~= "l13_generators" and name ~= "l11_hospital"
end
local function next_interval(mgr)
    local frequency = math.max(1, math.floor(tonumber(ui_options.get("alife/event/emission_frequency")) or 24))
    mgr._delta = math.random(math.max(1, math.floor(frequency / 2)) * 3600, frequency * 3600)
end
-- Location cluster: one emission for the whole Zone. Every server derives the
-- same schedule from the shared calendar (netcoop_cluster.inc keeps the game
-- clocks together): one emission per frequency slot at a slot-specific hour.
-- A server that comes up more than half an hour (game) after the start skips
-- that one; a finished slot is remembered across restarts.
local cluster_cached = nil
function cluster_mode()
    if cluster_cached == nil then
        local path = getFS and getFS():update_path("$app_data_root$", "netcoop_cluster.ltx")
        local file = path and io.open(path, "r")
        cluster_cached = file ~= nil
        if file then file:close() end
    end
    return cluster_cached
end
function reset_cluster_mode() cluster_cached = nil end -- tests, config change
local function frequency_hours()
    return math.max(1, math.floor(tonumber(ui_options.get("alife/event/emission_frequency")) or 24))
end
function scheduled_start(hours, frequency)
    local slot = math.floor(hours / frequency)
    local offset = ((slot * 2654435761) % 4294967296) / 4294967296 * frequency
    return slot * frequency + offset, slot
end
-- Returns true (start now) and the seconds already elapsed when the server
-- was restarted during this slot's emission (doc 43 J05): it resumes at the
-- same phase. The emission runs at time factor 10, so its 222 real seconds
-- span duration*10 game seconds.
-- Game hours since 2012-01-01. diffSec returns a float: counted from year 0
-- (about 6e10 s) it moved in ~1.1-hour steps, which broke the emission
-- schedule and the weather hour (2026-10-06); from 2012 it is exact to seconds.
local function game_hours()
    local base = game.CTime()
    if base.set then base:set(2012, 1, 1, 0, 0, 0, 0) end
    return game.get_game_time():diffSec(base) / 3600
end
local function cluster_due()
    local hours = game_hours()
    local frequency = frequency_hours()
    local at, slot = scheduled_start(hours, frequency)
    local state = alife_storage_manager.get_state()
    local span = duration * 10 / 3600
    if hours < at then return false end
    if state.netcoop_emission_slot == slot then
        -- Started before a restart and not finished: resume at its phase.
        if state.netcoop_emission_done ~= slot and hours - at < span then
            return true, (hours - at) * 3600 / 10
        end
        return false
    end
    if hours - at > 0.5 then return false end
    state.netcoop_emission_slot = slot
    return true, 0
end

-- Seconds into the running emission, -1 when none (tests, admin).
function current_elapsed() return started_at and elapsed() or -1 end

local function payload()
    return string.format("%d|%d|%.3f|%d", sequence, started_at and 1 or 0, elapsed(), duration)
end

function start(elapsed_seconds)
    install()
    if started_at then return false end
    if not valid_level() then return false end
    local flags = { allow = true }
    SendScriptCallback("on_before_surge", flags)
    if flags.allow == false then return false end
    local mgr = manager()
    sequence = sequence + 1
    started_at, normal_factor = time_global() - math.floor((elapsed_seconds or 0) * 1000), level.get_time_factor()
    players, next_send = {}, 0
    mgr.inited_time = game.get_game_time()
    mgr.game_time_factor = normal_factor
    mgr.started, mgr.finished = true, false
    level.set_time_factor(10)
    SetEvent("surge", "state", true)
    SendScriptCallback("actor_on_interaction", "anomalies", nil, "emission_start")
    printf("[Lost Zone] emission started: " .. sequence)
    return true
end

-- Artefacts after an emission (doc 43 L06): GAMMA refills the anomaly fields
-- that are online when it ends (emission_end). Fields far from every player
-- are offline then and, on a location server whose map never changes, never
-- got their share. The emissions are counted; a field that comes online after
-- emissions it missed gets its respawn then, before a player is near.
local function zone_emissions()
    local state = alife_storage_manager.get_state()
    state.netcoop_zone_emissions = state.netcoop_zone_emissions or {}
    return state, state.netcoop_zone_emissions
end
function zone_catch_up(binder)
    local state, seen = zone_emissions()
    local count = state.netcoop_emissions or 0
    local name = binder and binder.object and binder.object:name()
    if not name then return end
    if (seen[name] or 0) < count and binder.respawn_artefacts_and_replace_anomaly_zone then
        binder:respawn_artefacts_and_replace_anomaly_zone()
    end
    seen[name] = count
end
local function mark_online_zones()
    local state, seen = zone_emissions()
    for _, binder in pairs(db.anomaly_by_name or {}) do
        local name = binder.object and binder.object:name()
        if name then seen[name] = state.netcoop_emissions or 0 end
    end
end

function finish()
    if not started_at then return false end
    local mgr = manager()
    -- Stock world mortality respects story NPCs, faction immunity and shelters.
    -- Player mortality is evaluated independently in update_player().
    mgr:kill_objects_at_pos(false, "kill_at_end", false)
    mgr:kill_crows_at_pos(false, true)
    mgr.started, mgr.finished = false, true
    mgr.last_surge_time = game.get_game_time()
    started_at = nil
    local state = alife_storage_manager.get_state()
    if state.netcoop_emission_slot then state.netcoop_emission_done = state.netcoop_emission_slot end
    level.set_time_factor(normal_factor or 6)
    next_interval(mgr)
    SetEvent("surge", "state", false)
    SendScriptCallback("actor_on_interaction", "anomalies", nil, "emissions")
    local count_state = alife_storage_manager.get_state()
    count_state.netcoop_emissions = (count_state.netcoop_emissions or 0) + 1
    SendScriptCallback("actor_on_interaction", "anomalies", nil, "emission_end")
    mark_online_zones() -- these were refilled by emission_end just now
    netcoop_broadcast("emission", payload())
    next_send = time_global() + 1000
    printf("[Lost Zone] emission finished: " .. sequence)
    return true
end

function install()
    if installed then return end
    installed = true
    local mgr = manager()
    -- The shelters (GAMMA fills them in initialize() on the Actor's load,
    -- which the server never has): without them pos_in_cover() said "no" and
    -- every online NPC outside a surge-safe smart died at the end, sheltered
    -- or not.
    if mgr.init_surge_covers then pcall(mgr.init_surge_covers, mgr) end
    -- Fields coming online catch up on the emissions they missed.
    local zone_class = bind_anomaly_zone and bind_anomaly_zone.anomaly_zone_binder
    if zone_class and zone_class.net_spawn and not zone_class.netcoop_catch_up then
        local original = zone_class.net_spawn
        zone_class.netcoop_catch_up = true
        zone_class.net_spawn = function(self, se_abstract)
            local result = original(self, se_abstract)
            if result ~= false then pcall(zone_catch_up, self) end
            return result
        end
    end
    -- The dedicated server has no Actor binder to run the stock main loop.
    mgr.update = function() end
    mgr.start = function() return start() end
    mgr.end_surge = function() return finish() end
    mgr.started, mgr.finished = false, true
    mgr.last_surge_time = game.get_game_time()
    next_interval(mgr)
    local state = alife_storage_manager.get_state()
    if state.artefact_respawn_levels and state.artefact_respawn_levels[level.name()] then
        state.artefact_respawn_levels[level.name()] = nil
        bind_anomaly_zone.force_spawn_artefacts()
    end
end

function update_world()
    install()
    local mgr = manager()
    if not started_at and valid_level() and ui_options.get("alife/event/emission_state") then
        if cluster_mode() then
            local due, elapsed = cluster_due()
            if due then start(elapsed) end
        elseif game.get_game_time():diffSec(mgr.last_surge_time) >= mgr._delta then
            start()
        end
    end
    -- Finish after every player's final damage tick, rather than before it.
    if started_at and elapsed() >= duration + 1 then finish() end
    if time_global() >= next_send then
        next_send = time_global() + 1000
        netcoop_broadcast("emission", payload())
    end
end

local function safe_cover(mgr, actor)
    local pos, nearest, distance = actor:position(), nil, math.huge
    for name, conditions in pairs(mgr.covers or {}) do
        local zone = db.zone_by_name[name]
        if zone and (not conditions or xr_logic.pick_section_from_condlist(actor, zone, conditions) == "true") then
            if zone:inside(pos) then return zone:id(), zone:id() end
            local d = pos:distance_to_sqr(zone:position())
            if d < distance then nearest, distance = zone:id(), d end
        end
    end
    return nil, nearest
end
local function protected(actor)
    local community = character_community(actor)
    return (netcoop_server_compat.god_mode[actor:id()] == true)
        or load_var(actor, "surge_immuned", false) == true
        or community == "actor_monolith" or community == "actor_zombied"
end
local function hit_player(mgr, actor, power)
    -- Drug protection is cached by the single-player manager; clear it between owners.
    mgr.drug_telepatic_protection, mgr.drug_radiation_protection, mgr.drug_chemical_burn_protection = nil, nil, nil
    local h = hit()
    h.type, h.impulse, h.direction, h.draftsman = hit.telepatic, 0, VEC_Z, actor
    h.power = mgr:hit_power(power, h.type)
    if mgr.survive and xr_logic.pick_section_from_condlist(actor, nil, mgr.survive) == "true" then
        h.power = math.min(h.power, math.max(0, actor.health - 0.05))
    end
    if h.power > 0 then actor:hit(h) end
end

function update_player(actor)
    local mgr, id = manager(), actor:id()
    local own = players[id]
    if not own then
        own = { last = elapsed(), wave1 = false, wave2 = false }
        players[id] = own
        netcoop_send_to_actor(id, "emission", payload())
    end
    local cover, nearest = safe_cover(mgr, actor)
    SetEvent("current_safe_cover", cover)
    SetEvent("nearest_safe_cover", nearest)
    if not started_at then return end
    local t = math.min(duration, elapsed())
    SetEvent("surge", "time", t)
    if t >= 30 and not own.task then
        own.task = true
        task_manager.get_task_manager():give_task("hide_from_surge")
    end
    local dt = math.max(0, math.min(1, t - own.last))
    own.last = t
    if not actor:alive() or cover or protected(actor) then
        own.wave1, own.wave2 = t >= 137, t >= 185
        return
    end
    if t >= 108 and t < 210 then hit_player(mgr, actor, 0.3 * dt / 10) end
    if t >= 137 and not own.wave1 then
        own.wave1 = true
        hit_player(mgr, actor, 2.5)
    end
    local fate = ui_options.get("alife/event/emission_fate") or "kill_at_wave"
    if t >= 185 and not own.wave2 then
        own.wave2 = true
        if fate ~= "kill_at_end" then hit_player(mgr, actor, 10) end
    end
    if t >= duration then hit_player(mgr, actor, 10) end
end
