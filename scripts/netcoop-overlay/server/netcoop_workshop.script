----------------------------------------------------------------------
-- The workshop on the server (README stage 2, doc 87 §12): crafting,
-- disassembly and recipes from books. GAMMA does all three in Lua where the
-- player acts; on a pure client alife_create_item/alife_release are dropped,
-- so a craft took nothing and gave nothing. Here the server runs GAMMA's own
-- code (ui_workshop.UIWorkshopCraft with every mod's patch: nearby stashes,
-- partial ammo boxes, belt artefacts kept out, low-condition first,
-- artefact condition averaging) for that player against its own inventory:
-- the client sends only which recipe, and from which workshop.
-- netcoop_server_compat.item_action calls in with db.actor bound to the player.
----------------------------------------------------------------------

-- An object that accepts any UI call: the craft window's widgets.
local stub
stub = setmetatable({}, {
	__index = function(t, k)
		if type(k) == "number" then return t end
		return function() return t end
	end,
})

-- GAMMA's craft code with its icon/sound/list helpers turned off.
local function quietly(fn, ...)
	local xml, obj, ws = utils_xml, utils_obj, ui_workshop
	local icon, sound, element = xml and xml.set_icon, obj and obj.play_sound, ws.list_element
	if xml then xml.set_icon = function() end end
	if obj then obj.play_sound = function() end end
	ws.list_element = function() return stub end
	local ok, a, b = pcall(fn, ...)
	if xml then xml.set_icon = icon end
	if obj then obj.play_sound = sound end
	ws.list_element = element
	if not ok then error(a, 0) end
	return a, b
end

----------------------------------------------------------------------
-- Recipes the player knows (books read), kept with the character
----------------------------------------------------------------------
-- GAMMA's window knows these without a book (ui_workshop UIWorkshopCraft.__init).
local DEFAULT_RECIPES = { recipe_basic_0 = true, recipe_advanced_0 = true, recipe_expert_0 = true,
	recipe_drug_0 = true, recipe_ammo_0 = true, recipe_artefacts_0 = true }

local function pstor(actor_id)
	local obj = level.object_by_id(actor_id)
	if not obj then return nil end
	local st = db.storage[actor_id] or { object = obj }
	db.storage[actor_id] = st
	st.pstor = st.pstor or {}
	return st.pstor
end

function known_recipes(actor_id)
	local out = {}
	local p = pstor(actor_id)
	for sec in string.gmatch(p and p.netcoop_recipes or "", "[%w_]+") do out[sec] = true end
	return out
end

local function knows(actor_id, rsp)
	return DEFAULT_RECIPES[rsp] or known_recipes(actor_id)[rsp] or false
end

local function send_recipes(actor_id)
	local list = {}
	for sec in pairs(known_recipes(actor_id)) do list[#list + 1] = sec end
	table.sort(list)
	if netcoop_send_to_actor then netcoop_send_to_actor(actor_id, "recipes", table.concat(list, ",")) end
end

-- "recipe_read": a recipe book read for the first time is learned and used up.
function read_recipe(actor_id, book)
	local sec = book:section()
	if not (IsItem and IsItem("recipe", sec)) then return "this is not a recipe" end
	local p = pstor(actor_id)
	if not p then return "player is not available" end
	local have = known_recipes(actor_id)
	if have[sec] then send_recipes(actor_id) return game.translate_string("st_recipe_is_known") end
	have[sec] = true
	local list = {}
	for s in pairs(have) do list[#list + 1] = s end
	table.sort(list)
	p.netcoop_recipes = table.concat(list, ",")
	alife_release(book)
	send_recipes(actor_id)
	printf("[Lost Zone][workshop] %s learned %s", tostring(actor_id), sec)
	return ""
end

-- command "recipes get" (after login)
function command(actor_id, args)
	if args == "get" then send_recipes(actor_id) end
end

----------------------------------------------------------------------
-- Which workshop: a toolkit in hand, a mechanic's vise, a furniture workshop
----------------------------------------------------------------------
-- workshop_tool's openers and the window flags each passes (basic, advanced,
-- expert, drug, ammo).
local TOOL_FLAGS = {
	["workshop_tool.start_workshop_basic"] = { true, false, false, false, false },
	["workshop_tool.start_workshop_advanced"] = { false, true, false, false, false },
	["workshop_tool.start_workshop_expert"] = { false, false, true, false, false },
	["workshop_tool.start_workshop_medic"] = { false, false, false, true, false },
	["workshop_tool.start_workshop_ammo"] = { false, false, false, false, true },
	["workshop_tool.start_workshop_artefacts"] = { false, false, false, false, false },
}

local function tool_flags(sec)
	for i = 1, 10 do
		local f = ini_sys:r_string_ex(sec, "use" .. i .. "_action_functor")
		if f and TOOL_FLAGS[f] then return TOOL_FLAGS[f] end
	end
	return nil
end

-- A mechanic's vise (bind_awr): access and the tiers the mechanic gave this player.
local function vise_flags(obj)
	local name = obj:name() or ""
	if not string.match(name, "awr_tiski") then return nil end
	if not (bind_awr and bind_awr.access and bind_awr.access(obj)) then return nil, "the mechanic has not given you access" end
	local ini = itms_manager and itms_manager.ini_manager
	local list = ini and parse_list and parse_list(ini, "workshop_angles", name)
	local mechanic = list and list[1]
	if not mechanic then return { false, false, false, false, false } end
	local drug = ini:r_string_ex("drugkit_access", mechanic)
	return { db.actor:has_info(mechanic .. "_upgrade_tier_1"), db.actor:has_info(mechanic .. "_upgrade_tier_2"),
		db.actor:has_info(mechanic .. "_upgrade_tier_3"), drug and db.actor:has_info(drug) or false, false }
end

-- A furniture workshop's stash (ui_furniture_workshop.OpenWorkshop(stashId)).
local function is_workshop_stash(id)
	local m = alife_storage_manager and alife_storage_manager.get_state()
	for _, stash_id in pairs(m and m.workshop_stashes or {}) do
		if stash_id == id then return true end
	end
	return false
end

-- flags, stash id | nil, reason
local function source(kind, obj)
	if kind == 1 then
		local f = tool_flags(obj:section())
		if f then return f, nil end
		return nil, "this item is not a workshop"
	elseif kind == 2 then
		local f, err = vise_flags(obj)
		if f then return f, nil end
		if err then return nil, err end
		if is_workshop_stash(obj:id()) then return { false, false, false, false, false }, obj:id() end
	end
	return nil, "this is not a workshop"
end

-- UIWorkshop:Reset as patched by zzzzzz_ui_workshop_nearby_stashes: a toolkit
-- is there when the workshop gives it or one (or a higher general tier) is
-- in the inventory, the workshop's stash or a stash in range.
local function toolkits_state(flags, stash_id)
	local kits = ui_workshop.workshop_toolkits
	local range = ui_mcm and ui_mcm.get("craft_from_stashes/range") or 10
	local function have(i)
		if flags[i] then return true end
		local v = collect_amount_in_range and next(collect_amount_in_range(range, kits[i], stash_id))
		return v ~= nil
	end
	local state = {}
	for i = 1, #kits do
		local ok = have(i)
		if not ok and i <= 2 then
			for j = i + 1, 3 do if have(j) then ok = true; break end end
		end
		state[i] = ok
	end
	return state
end

----------------------------------------------------------------------
-- Crafting
----------------------------------------------------------------------
local function craft_window(stash_id, kits)
	return setmetatable({
		recipes = {}, recipes_type = {}, list_menu = stub,
		craft_item = {}, craft_item_remain = {}, craft_allow = {}, complexCraft = {},
		resetcomplexCraft = false, craft_allow_r = false, craft_item_r = nil,
		toolkits_state = kits, stashId = stash_id,
		owner = { stashId = stash_id, Close = function() end },
		last_cont = false, last_idx = false,
	}, { __index = function() return stub end })
end

-- "craft <type> <index>" from the workshop object (kind 1: a toolkit carried,
-- kind 2: a vise or furniture workshop within reach).
function craft(actor_id, kind, obj, action)
	local t, i = string.match(action, "^craft (%d+) (%d+)$")
	t, i = tonumber(t), tonumber(i)
	if not (t and i) then return "bad recipe" end
	local ws = ui_workshop and ui_workshop.UIWorkshopCraft
	if not (ws and ws.LoadRecipes and ws.UpdateItem and ws.Craft) then return "the workshop is not loaded on the server" end
	local flags, stash_or_err = source(kind, obj)
	if not flags then return stash_or_err end
	local stash_id = stash_or_err
	local w = craft_window(stash_id, toolkits_state(flags, stash_id))
	quietly(ws.LoadRecipes, w)
	local r = w.recipes[t] and w.recipes[t][i]
	if not r then return "no such recipe" end
	if not knows(actor_id, r.rsp) then return game.translate_string("craft_warning_2") end
	for n = 1, 4 do
		if r[n] then quietly(ws.UpdateItem, w, n, r[n][1], r[n][2], false, nil, nil) end
	end
	quietly(ws.UpdateItem, w, nil, r.sec, 1, true, r.tool, ui_workshop.workshop_toolkits[r.tool])
	if not w.craft_allow_r then
		for n = 1, 4 do
			if r[n] and not w.craft_allow[n] then return game.translate_string("craft_warning_4") end
		end
		return game.translate_string("craft_warning_3")
	end
	quietly(ws.Craft, w)
	printf("[Lost Zone][workshop] %s crafted %s", tostring(actor_id), r.sec)
	return ""
end

----------------------------------------------------------------------
-- Disassembly: the item and the tool in the player's inventory; GAMMA's own
-- disassembly (parts, chance, tool wear, battery out of a device).
----------------------------------------------------------------------
function disassemble(obj, tool)
	local ip = item_parts
	if not (ip and ip.disassembly_item) then return "disassembly is not loaded on the server" end
	if ip.is_suitable_dtool and not ip.is_suitable_dtool(obj, tool) then return game.translate_string("st_news_dis_items") end
	if IsWeapon(obj) then ip.disassembly_weapon(obj, tool)
	elseif IsOutfit(obj) or IsHeadgear(obj) then ip.disassembly_outfit(obj, tool)
	else ip.disassembly_item(obj, tool) end
	return ""
end
