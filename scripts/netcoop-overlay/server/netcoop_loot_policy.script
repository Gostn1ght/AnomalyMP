-- L22: birth loot depends on saved world context, never presence/restart.
-- GAMMA remains the generator; this policy gates its initial NPC generators.
local config
local function ini()
    config = config or ini_file("netcoop\\loot_policy.ltx")
    return config
end
local function number(section, key, default, lo, hi)
    local value = tonumber(ini():r_float_ex(section, key))
    if not value or value ~= value then value = default end
    return math.max(lo, math.min(hi, value))
end
local function hours()
    local base = game.CTime()
    base:set(2012, 1, 1, 0, 0, 0, 0)
    return game.get_game_time():diffSec(base) / 3600
end
function world_seed()
    local state = alife_storage_manager.get_state()
    state.netcoop_loot_policy = state.netcoop_loot_policy or {}
    local policy = state.netcoop_loot_policy
    if not policy.seed then policy.seed = (os.time() % 100000) * 7919 + 1 end
    return policy.seed
end
local function hash(value)
    local result = 0
    for i = 1, #value do result = (result * 31 + string.byte(value, i)) % 2147483647 end
    return result
end
function random(seed)
    local value = seed % 2147483647
    if value <= 0 then value = value + 2147483646 end
    return function(lo, hi)
        value = (value * 16807) % 2147483647
        local r = (value - 1) / 2147483646
        if lo == nil then return r end
        if hi == nil then hi, lo = lo, 1 end
        -- Lua 5.1 converts numeric bounds to integers (GAMMA passes floats).
        lo, hi = tonumber(lo), tonumber(hi)
        lo = lo >= 0 and math.floor(lo) or math.ceil(lo)
        hi = hi >= 0 and math.floor(hi) or math.ceil(hi)
        if hi < lo then error("empty random interval") end
        return lo + math.floor(r * (hi - lo + 1))
    end
end
local stages = {"ammo", "powders", "bullets", "casings", "sin_artefacts", "community", "private"}
local function economy_factor(state)
    -- ALife registers NPCs before GAMMA's on_game_load initializes factors.
    -- Prefer the actual saved override/preset rather than a stale module cache.
    local saved = type(state.diff_eco) == "table" and state.diff_eco or nil
    local value = saved and tonumber(saved.loots)
    if not saved then value = game_difficulties and game_difficulties.get_eco_factor("loots") end
    if value == nil then
        local preset = tonumber(saved and saved.type) or 1
        if preset ~= preset or preset < 1 or preset > 3 then preset = 1 end
        value = ini_file("plugins\\difficulty.ltx"):r_float_ex("econ_" .. math.floor(preset), "loots")
    end
    value = tonumber(value) or 1
    if value ~= value then value = 1 end
    return math.max(0, math.min(3, value))
end
function world_event(event)
    if event.kind ~= "battle" or type(event.level) ~= "string" or type(event.h) ~= "number" then return end
    world_seed()
    local policy = alife_storage_manager.get_state().netcoop_loot_policy
    policy.battles = policy.battles or {}
    policy.battles[event.level] = {hour = event.h, seq = event.seq or 0}
end
function context_for(npc, map)
    local id, name = npc:id(), npc:name()
    local saved = se_load_var(id, name, "netcoop_loot_context")
    if type(saved) == "table" and saved.schema == 1 and (not saved.name or saved.name == name) then return saved end
    map = map or level.name()
    local state, now = alife_storage_manager.get_state(), hours()
    local economy = economy_factor(state)
    local last_emission = tonumber(state.netcoop_last_emission_hour)
    local after_emission = last_emission and now >= last_emission and
        now - last_emission < number("policy", "emission_hours", 2, 0, 168) or false
    local battle_seq = 0
    world_seed()
    local policy = state.netcoop_loot_policy
    local horizon = number("policy", "battle_hours", 6, 0, 168)
    local battle = policy.battles and policy.battles[map]
    if battle and now >= battle.hour and now - battle.hour < horizon then battle_seq = battle.seq end
    if netcoop_world_events then
        -- Migration/catch-up for worlds whose older journal predates this hook.
        for _, event in ipairs(netcoop_world_events.recent(64)) do
            if event.kind == "battle" and event.level == map and
                type(event.h) == "number" and now >= event.h and now - event.h < horizon then
                battle_seq = math.max(battle_seq, event.seq or 0)
            end
        end
    end
    local context = {schema = 1, name = name, level = map, hour = now, economy = economy, battle_seq = battle_seq,
        emissions = state.netcoop_emissions or 0, after_emission = after_emission, chances = {}}
    context.seed = (world_seed() + id * 7 + hash(name) + context.emissions * 104729 + battle_seq * 65537) % 2147483647
    for _, stage in ipairs(stages) do
        local chance = number("base", stage, 1, 0, 1)
        -- GAMMA already applies economy to community/private item lists.
        if stage ~= "community" and stage ~= "private" then chance = chance * economy end
        if after_emission then chance = chance * number("after_emission", stage, 1, 0, 3) end
        if battle_seq > 0 then chance = chance * number("battle", stage, 1, 0, 3) end
        context.chances[stage] = math.min(1, chance)
    end
    se_save_var(id, name, "netcoop_loot_context", context)
    return context
end
function allows(context, stage)
    local chance = context.chances[stage]
    if chance == nil then return false end
    return random(context.seed + hash(stage))() < chance
end
local function upvalue(fn, wanted)
    if type(fn) ~= "function" or not (debug and debug.getupvalue and debug.setupvalue) then return nil end
    for i = 1, 64 do
        local name, value = debug.getupvalue(fn, i)
        if not name then return nil end
        if name == wanted then return i, value end
    end
end
local function prepare_lists(context)
    local fn = death_manager and death_manager.create_item_list
    local ini = itms_manager and itms_manager.ini_death
    local index, original = upvalue(fn, "item_by_community")
    local count_index, counts = upvalue(fn, "shuffle_cnt")
    if not (ini and index and count_index and type(original) == "table") then return nil end
    -- GAMMA scales cached chances before the first player initializes economy,
    -- then shuffles shared lists according to which NPCs came online first.
    -- Use fresh, canonical lists with the saved economy for this birth only.
    local lists = setmetatable({}, {__index = function(t, profile)
        if not original[profile] then return nil end
        local list = {}
        if ini:section_exist(profile) then
            for i = 0, ini:line_count(profile) - 1 do
                local _, section, chance = ini:r_line_ex(profile, i, "", "")
                local factor = ini:line_exist("exclude_from_multi", section) and 1 or context.economy
                list[#list + 1] = {sec = section, cha = (tonumber(chance) or 0) * factor}
            end
        else
            for _, row in ipairs(original[profile]) do list[#list + 1] = {sec = row.sec, cha = row.cha} end
        end
        table.sort(list, function(a, b) return a.sec == b.sec and a.cha < b.cha or a.sec < b.sec end)
        t[profile] = list
        return list
    end})
    debug.setupvalue(fn, index, lists)
    debug.setupvalue(fn, count_index, {})
    return function()
        debug.setupvalue(fn, index, original)
        debug.setupvalue(fn, count_index, counts)
    end
end
function with_random(context, fn)
    local previous = math.random
    math.random = random(context.seed)
    local restore
    local ok, result = pcall(function() restore = prepare_lists(context); return fn() end)
    if restore then restore() end
    math.random = previous -- also restore after a generator error
    return ok, result
end

-- Registration is an ALife event even for offline NPCs, before a player
-- observes them. Existing worlds latch missing contexts when loading.
local function registered(se, kind)
    if kind ~= "se_stalker" or not se:alive() then return end
    local ok, err = pcall(function()
        local graph, sim = game_graph(), alife()
        local map = sim:level_name(graph:vertex(se.m_game_vertex_id):level_id())
        context_for({id = function() return se.id end, name = function() return se:name() end}, map)
    end)
    if not ok then printf("[Lost Zone] NPC birth loot context error: %s", tostring(err)) end
end

function on_game_start()
    if not (netcoop_enabled and netcoop_enabled()) or (netcoop_pure_client and netcoop_pure_client()) then return end
    RegisterScriptCallback("server_entity_on_register", registered)
end
