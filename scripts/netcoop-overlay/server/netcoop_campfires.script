-- Lost Zone: camp fires are the players' (owner 2026-10-24: "camp fires must
-- not burn by themselves; players light them and put them out, and everyone
-- sees the same").
--
-- Anomaly's axr_turn_on_campfire sent a camp NPC to every unlit fire of its
-- smart, so camps burned from the start and a fire put out was lit again;
-- since 2026-10-13 only in the evening and at night, which the owner still
-- saw as fires burning by themselves. NPCs no longer light camp fires. A
-- player lights one with matches and puts it out with "use" (the server
-- decides, netcoop_campfire.inc, and every client shows it); a fire burns
-- out after 3 game hours. Quest fires (Hidden Threat) and a player's own
-- placed campfire keep their scripts.

-- The NPC evaluator: never a fire to light; a selection left from before
-- (a saved state) is released.
local function find_valid_target(self)
	local selected = axr_turn_on_campfire.already_selected
	if self.st.selected_id and selected[self.st.selected_id] == self.object:id() then
		selected[self.st.selected_id] = nil
	end
	self.st.selected_id = nil
	return false
end

function on_game_start()
	if not (axr_turn_on_campfire and axr_turn_on_campfire.eva_turn_on_campfire) then
		printf("! [Lost Zone][campfire] axr_turn_on_campfire not found: NPCs may still light fires")
		return
	end
	axr_turn_on_campfire.eva_turn_on_campfire.find_valid_target = find_valid_target
	printf("[Lost Zone][campfire] NPCs do not light camp fires; players light and put them out")
end
