-- Artefacts on a location server (owner 2026-10-10: "арты не появляются после
-- выброса - не респавнятся").
-- In single player GAMMA spawns artefacts two ways:
--   * the emission/psi storm end (actor_on_interaction "anomalies"
--     "emission_end"): bind_anomaly_zone refills the anomaly fields,
--     drx_da_main the dynamic anomalies;
--   * grok_artefacts_random_spawner on actor_on_update: some time after the
--     player arrives on a map (30-77 s, each next try a bit later), fields and
--     dynamic anomalies get new artefacts.
-- The dedicated server blocked every actor_on_* callback that is client
-- feedback, and these two with them: no artefact ever came back. The emission
-- one passes now (netcoop_server_compat); the periodic one runs here while
-- players are on this map, restarting its delays when a player arrives - as
-- GAMMA does when the player comes to a map.

local present = {}   -- player Actor id -> true
local ticking = false

local function spawner() return grok_artefacts_random_spawner end

-- GAMMA's set_delay(): a player came to this map.
local function arrival()
	local s = spawner()
	if not s then return end
	s.delay1, s.delay2 = 30250, 77520
	s.spawned = 0
end

----------------------------------------------------------------------
-- Anomaly fields far from players (doc 43 L06): GAMMA refills, at the
-- emission's end, only the fields online then (db.anomaly_by_name) - on a
-- server, those near a player. A field online later stayed empty until the
-- next emission, so it was the first player to arrive, not the emission, that
-- decided. The emission is recorded (with the world: alife storage); a field
-- that comes online later gets that emission's refill once, with the
-- emission's chance.
----------------------------------------------------------------------
local function store()
	local m = alife_storage_manager and alife_storage_manager.get_state()
	if not m then return nil end
	m.netcoop_af = m.netcoop_af or { stamp = 0, kind = "", done = {} }
	return m.netcoop_af
end

-- L07: the refill of a far field is decided by the world, the emission and
-- the field, not by when the first player came: GAMMA's own rolls (layer,
-- chance, artefact type, path and path point - points the map authors laid
-- inside the field) run on a generator seeded from the persistent world seed,
-- the emission's number and the field's name. The same world and emission
-- give the same artefacts at the same points whenever the field comes online.
local function hash(text)
	local h = 0
	for i = 1, #text do h = (h * 31 + string.byte(text, i)) % 2147483647 end
	return h
end

function refill_seed(zone_name, kind, stamp)
	local world = netcoop_loot_policy and netcoop_loot_policy.world_seed() or 1
	return (world + hash(zone_name) + hash(kind or "") * 7 + (stamp or 0) * 104729) % 2147483647
end

local function refill(zone, kind, stamp)
	local s, p = surge_manager and surge_manager.get_surge_manager(), psi_storm_manager and psi_storm_manager.get_psi_storm_manager()
	local was_s, was_p = s and s.started, p and p.started
	-- the emission's chance (respawn_artefacts_and_replace_anomaly_zone reads it from the running event)
	if s then s.started = kind == "emission_end" end
	if p then p.started = kind == "psi_storm_end" end
	local game_random = math.random
	local seeded = stamp and netcoop_loot_policy and netcoop_loot_policy.random
	if seeded then math.random = seeded(refill_seed(zone.object:name(), kind, stamp)) end
	local ok, err = pcall(zone.respawn_artefacts_and_replace_anomaly_zone, zone)
	math.random = game_random
	if s then s.started = was_s end
	if p then p.started = was_p end
	if not ok then printf("! [Lost Zone] artefact refill failed: %s", tostring(err)) end
end

local function on_interaction(typ, obj, name)
	if typ ~= "anomalies" or not (name == "emission_end" or name == "psi_storm_end") then return end
	local st = store()
	if not st then return end
	st.stamp, st.kind, st.done = (st.stamp or 0) + 1, name, {}
	-- online now: GAMMA refills these itself
	for zone_name in pairs(db.anomaly_by_name or {}) do st.done[zone_name] = true end
	printf("[Lost Zone] artefacts: %s #%s, far fields refill when they come online", name, tostring(st.stamp))
end

local function install_far_refill()
	local binder = bind_anomaly_zone and bind_anomaly_zone.anomaly_zone_binder
	if not (binder and binder.net_spawn) or binder.__netcoop then return end
	binder.__netcoop = true
	local base = binder.net_spawn
	binder.net_spawn = function(self, se)
		if not base(self, se) then return false end
		local st = store()
		local zone_name = self.object and self.object:name()
		if st and zone_name and (st.stamp or 0) > 0 and not st.done[zone_name] then
			st.done[zone_name] = true
			refill(self, st.kind, st.stamp)
		end
		return true
	end
end

function on_game_start()
	if not (netcoop_enabled and netcoop_enabled()) or (netcoop_pure_client and netcoop_pure_client()) then return end
	RegisterScriptCallback("actor_on_interaction", on_interaction)
	install_far_refill()
end

function update_world()
	local s = spawner()
	if not (s and s.grok_artefact_spawner) then return end
	local now, any = {}, false
	for id in string.gmatch(netcoop_players and netcoop_players() or "", "%d+") do
		id = tonumber(id)
		now[id], any = true, true
		if not present[id] then arrival() end
	end
	present = now
	if not any then return end
	if not (s.delay1 and s.delay2) then arrival() end
	local ok, err = pcall(s.grok_artefact_spawner)
	if not ok and not ticking then
		ticking = true -- report once, keep the server running
		printf("! [Lost Zone] artefact spawner error: %s", tostring(err))
	end
end
