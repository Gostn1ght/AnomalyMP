-- Artefacts on a location server (owner 2026-10-10: "арты не появляются после
-- выброса - не респавнятся").
-- In single player GAMMA spawns artefacts two ways:
--   * the emission/psi storm end (actor_on_interaction "anomalies"
--     "emission_end"): bind_anomaly_zone refills the anomaly fields,
--     drx_da_main the dynamic anomalies;
--   * grok_artefacts_random_spawner on actor_on_update: some time after the
--     player arrives on a map (30-77 s, each next try a bit later), fields and
--     dynamic anomalies get new artefacts.
-- The dedicated server blocked every actor_on_* callback that is client
-- feedback, and these two with them: no artefact ever came back. The emission
-- one passes now (netcoop_server_compat); the periodic one runs here while
-- players are on this map, restarting its delays when a player arrives - as
-- GAMMA does when the player comes to a map.

local present = {}   -- player Actor id -> true
local ticking = false

local function spawner() return grok_artefacts_random_spawner end

-- GAMMA's set_delay(): a player came to this map.
local function arrival()
	local s = spawner()
	if not s then return end
	s.delay1, s.delay2 = 30250, 77520
	s.spawned = 0
end

----------------------------------------------------------------------
-- Anomaly fields far from players (doc 43 L06): GAMMA refills, at the
-- emission's end, only the fields online then (db.anomaly_by_name) - on a
-- server, those near a player. A field online later stayed empty until the
-- next emission, so it was the first player to arrive, not the emission, that
-- decided. The emission is recorded (with the world: alife storage); a field
-- that comes online later gets that emission's refill once, with the
-- emission's chance.
----------------------------------------------------------------------
local function store()
	local m = alife_storage_manager and alife_storage_manager.get_state()
	if not m then return nil end
	m.netcoop_af = m.netcoop_af or { stamp = 0, kind = "", done = {} }
	return m.netcoop_af
end

-- L07: the refill of a far field is decided by the world, the emission and
-- the field, not by when the first player came: GAMMA's own rolls (layer,
-- chance, artefact type, path and path point - points the map authors laid
-- inside the field) run on a generator seeded from the persistent world seed,
-- the emission's number and the field's name. The same world and emission
-- give the same artefacts at the same points whenever the field comes online.
local function hash(text)
	local h = 0
	for i = 1, #text do h = (h * 31 + string.byte(text, i)) % 2147483647 end
	return h
end

function refill_seed(zone_name, kind, stamp)
	local world = netcoop_loot_policy and netcoop_loot_policy.world_seed() or 1
	return (world + hash(zone_name) + hash(kind or "") * 7 + (stamp or 0) * 104729) % 2147483647
end

local function refill(zone, kind, stamp)
	local s, p = surge_manager and surge_manager.get_surge_manager(), psi_storm_manager and psi_storm_manager.get_psi_storm_manager()
	local was_s, was_p = s and s.started, p and p.started
	-- the emission's chance (respawn_artefacts_and_replace_anomaly_zone reads it from the running event)
	if s then s.started = kind == "emission_end" end
	if p then p.started = kind == "psi_storm_end" end
	local game_random = math.random
	local seeded = stamp and netcoop_loot_policy and netcoop_loot_policy.random
	if seeded then math.random = seeded(refill_seed(zone.object:name(), kind, stamp)) end
	local ok, err = pcall(zone.respawn_artefacts_and_replace_anomaly_zone, zone)
	math.random = game_random
	if s then s.started = was_s end
	if p then p.started = was_p end
	if not ok then printf("! [Lost Zone] artefact refill failed: %s", tostring(err)) end
end

local function on_interaction(typ, obj, name)
	if typ ~= "anomalies" or not (name == "emission_end" or name == "psi_storm_end") then return end
	local st = store()
	if not st then return end
	st.stamp, st.kind, st.done = (st.stamp or 0) + 1, name, {}
	-- online now: GAMMA refills these itself
	for zone_name in pairs(db.anomaly_by_name or {}) do st.done[zone_name] = true end
	printf("[Lost Zone] artefacts: %s #%s, far fields refill when they come online", name, tostring(st.stamp))
end

----------------------------------------------------------------------
-- NPCs search for artefacts offline (doc 43 L08). GAMMA's stalkers pick
-- artefacts up only online (xr_gather_items, near a player); far from
-- players the fields kept everything for the first player to come. Once a
-- game hour the server looks at artefacts lying offline on this map: a
-- squad of one of GAMMA's artefact-hunting communities (artifact_communities
-- in ai_tweaks\xr_gather_items.ltx) that has reached its smart terrain
-- within reach of one may take it. The chance follows the best hunter of
-- the squad: experience (rank), equipment (the detector he carries) and the
-- danger of the find (a costlier artefact lies in a worse anomaly). The
-- artefact goes into his inventory with its own ID
-- (alife():netcoop_take_offline, ALife's offline attach) and stays with
-- him, then on his corpse (L09). The rolls come from the world seed, the
-- artefact and the hour: a restart or a player's arrival does not reroll
-- them. A field coming online forgets artefacts taken from it, so GAMMA
-- can refill those places.
----------------------------------------------------------------------
local HUNT = {
	every_hours = 1,  -- game hours between looks
	reach = 80,       -- metres from the squad's smart terrain to the artefact
	base = 0.10,      -- chance per artefact and look: experienced hunter, basic detector, cheap artefact
	max_per_look = 2, -- artefacts taken on this map per look
}
local HUNT_RANK = { novice = 0.6, trainee = 0.8, experienced = 1.0, professional = 1.15, veteran = 1.3,
	expert = 1.4, master = 1.5, legend = 1.6 }
local HUNT_DETECTOR = { detector_simple = 1.0, detector_advanced = 1.3, detector_elite = 1.5, detector_scientific = 1.7 }
local HUNT_NO_DETECTOR = 0.3
local NO_PARENT = 65535
local hunter_communities

local function hunters()
	if hunter_communities then return hunter_communities end
	hunter_communities = {}
	local ok, list = pcall(function()
		return utils_data.collect_section(ini_file("ai_tweaks\\xr_gather_items.ltx"), "artifact_communities", true)
	end)
	for k, v in pairs(ok and list or {}) do
		if v == true then hunter_communities[k] = true elseif type(v) == "string" then hunter_communities[v] = true end
	end
	return hunter_communities
end

local function game_hours()
	local base = game.CTime()
	base:set(2012, 1, 1, 0, 0, 0, 0)
	return math.floor(game.get_game_time():diffSec(base) / 3600)
end

local function level_of(se)
	local ok, id = pcall(function() return game_graph():vertex(se.m_game_vertex_id):level_id() end)
	return ok and id or nil
end

-- How good a member is at finding artefacts (0: he cannot hunt).
function hunter_skill(member)
	if not (member and member:alive()) then return 0 end
	local rank = ranks and ranks.get_se_obj_rank_name and ranks.get_se_obj_rank_name(member)
	local skill = HUNT_RANK[rank or ""] or 1.0
	local detector = HUNT_NO_DETECTOR
	for id in alife():get_children(member) do
		local item = alife_object(id)
		local d = item and HUNT_DETECTOR[item:section_name()]
		if d and d > detector then detector = d end
	end
	return skill * detector
end

-- Offline squads staying at their smart terrain on this map, each with its best hunter.
local function hunting_squads(level_id)
	local found = {}
	local board = SIMBOARD and SIMBOARD.smarts
	for smart_id, info in pairs(board or {}) do
		local smart = info.smrt or alife_object(smart_id)
		if smart and level_of(smart) == level_id then
			for squad_id in pairs(info.squads or {}) do
				local squad = alife_object(squad_id)
				if squad and squad.online ~= true and squad.current_action == 1 and squad.current_target_id == smart_id
					and hunters()[squad.get_squad_community and squad:get_squad_community() or ""]
					and not (get_object_story_id and get_object_story_id(squad_id)) then
					local best, best_skill = nil, 0
					for member in squad:squad_members() do
						local se = alife_object(member.id)
						local skill = se and se.online ~= true and hunter_skill(se) or 0
						if skill > best_skill then best, best_skill = se, skill end
					end
					if best then found[#found + 1] = { smart = smart, hunter = best, skill = best_skill } end
				end
			end
		end
	end
	return found
end

local function artefact_danger(section)
	local cost = ini_sys and ini_sys:r_float_ex(section, "cost") or 0
	return math.max(0.35, math.min(1, 1 - (cost or 0) / 50000))
end

function hunt_look(hour)
	local sim = alife()
	local here = sim and level_of(sim:actor())
	if not here then return 0 end
	local squads = hunting_squads(here)
	if #squads == 0 then
		printf("[Lost Zone][artefacts] offline search: no hunting squad at a smart terrain")
		return 0
	end
	local lying = {}
	sim:iterate_objects(function(se)
		if se.parent_id == NO_PARENT and se.online ~= true and IsArtefact(nil, se:clsid()) and level_of(se) == here
			and not (ini_sys and ini_sys:r_bool_ex(se:section_name(), "quest_item", false)) then
			lying[#lying + 1] = se
		end
		return false
	end)
	table.sort(lying, function(a, b) return a.id < b.id end)
	local seed = netcoop_loot_policy.world_seed()
	local taken = 0
	for _, af in ipairs(lying) do
		if taken >= HUNT.max_per_look then break end
		local best, best_skill = nil, 0
		for _, sq in ipairs(squads) do
			if sq.skill > best_skill and sq.smart.position:distance_to(af.position) <= HUNT.reach then
				best, best_skill = sq, sq.skill
			end
		end
		if best then
			local roll = netcoop_loot_policy.random((seed + af.id * 7919 + hour * 104729) % 2147483647)()
			if roll < HUNT.base * best_skill * artefact_danger(af:section_name())
				and sim:netcoop_take_offline(best.hunter.id, af.id) then
				taken = taken + 1
				printf("[Lost Zone][artefacts] %s found %s (id %s) offline near %s", best.hunter:name(),
					af:section_name(), tostring(af.id), best.smart:name())
			end
		end
	end
	printf("[Lost Zone][artefacts] offline search: %s squads, %s artefacts lying offline, %s found", tostring(#squads),
		tostring(#lying), tostring(taken))
	return taken
end

function hunt_update()
	local sim = alife and alife()
	if not (sim and sim.netcoop_take_offline and netcoop_loot_policy and alife_storage_manager) then return end
	local m = alife_storage_manager.get_state()
	local hour = game_hours()
	m.netcoop_af_hunt = m.netcoop_af_hunt or {}
	local last = m.netcoop_af_hunt.hour
	if last and hour - last < HUNT.every_hours then return end
	m.netcoop_af_hunt.hour = hour
	local ok, err = pcall(hunt_look, hour)
	if not ok then printf("! [Lost Zone] artefact hunt failed: %s", tostring(err)) end
end

-- A field coming online forgets artefacts that left it while it was offline.
function forget_taken(zone)
	local gone = {}
	for id in pairs(zone.artefact_ways_by_id or {}) do
		local se = alife_object(tonumber(id))
		if not se or se.parent_id ~= NO_PARENT then gone[#gone + 1] = tonumber(id) end
	end
	for _, id in ipairs(gone) do pcall(zone.on_artefact_take, zone, { id = id }) end
	return #gone
end

local function install_far_refill()
	local binder = bind_anomaly_zone and bind_anomaly_zone.anomaly_zone_binder
	if not (binder and binder.net_spawn) or binder.__netcoop then return end
	binder.__netcoop = true
	local base = binder.net_spawn
	binder.net_spawn = function(self, se)
		if not base(self, se) then return false end
		forget_taken(self)
		local st = store()
		local zone_name = self.object and self.object:name()
		if st and zone_name and (st.stamp or 0) > 0 and not st.done[zone_name] then
			st.done[zone_name] = true
			refill(self, st.kind, st.stamp)
		end
		return true
	end
end

function on_game_start()
	if not (netcoop_enabled and netcoop_enabled()) or (netcoop_pure_client and netcoop_pure_client()) then return end
	RegisterScriptCallback("actor_on_interaction", on_interaction)
	install_far_refill()
end

function update_world()
	hunt_update()
	local s = spawner()
	if not (s and s.grok_artefact_spawner) then return end
	local now, any = {}, false
	for id in string.gmatch(netcoop_players and netcoop_players() or "", "%d+") do
		id = tonumber(id)
		now[id], any = true, true
		if not present[id] then arrival() end
	end
	present = now
	if not any then return end
	if not (s.delay1 and s.delay2) then arrival() end
	local ok, err = pcall(s.grok_artefact_spawner)
	if not ok and not ticking then
		ticking = true -- report once, keep the server running
		printf("! [Lost Zone] artefact spawner error: %s", tostring(err))
	end
end
