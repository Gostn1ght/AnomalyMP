-- Mutant butchering (GAMMA's ui_mutant_loot) by the server.
--
-- Before: the window rolled the parts on the player's client and created them
-- there with alife_create_item, which a client cannot do - butchering gave
-- nothing online - and "already butchered" lived in that client only. Now:
--   * the client asks to open (netcoop_item_action kind 2: the corpse exists
--     and is within reach, checked by the engine);
--   * the server rolls the parts once per corpse with GAMMA's loot_mutant
--     (mutant_loot.ltx, the player's hunting kit bonus), keeps them with the
--     corpse, refuses a decayed body (decay_time) or an empty one, and sends
--     the list ("mutant_loot" channel);
--   * the client's window shows that list and asks for the chosen parts; the
--     server checks the counts, creates the parts (GAMMA's condition rule),
--     wears the knife, and marks the corpse looted when nothing is left (NPC
--     corpse looting reads that, as in GAMMA).

local ITEM_PROPS = { cond_r = { 30, 70 }, cond_ct = "part", cond_cr = { 0.5, 0.75, 1 } }
local DECAY = 7200
local decay_read = false

local function decay_time()
	if not decay_read then
		decay_read = true
		local ini = ini_file("items\\settings\\mutant_loot.ltx")
		DECAY = ini and ini:r_float_ex("mutant_loot_mod", "decay_time") or DECAY
	end
	return DECAY
end

local function sorted_sections(loot)
	local list = {}
	for sec, t in pairs(loot) do
		if t.count and t.count > 0 then list[#list + 1] = sec end
	end
	table.sort(list)
	return list
end

-- "id|ok|sec*count;sec*count" (sections sorted), or "id|decayed" / "id|empty"
local function payload(id, status, loot)
	local parts = {}
	if loot then
		for _, sec in ipairs(sorted_sections(loot)) do parts[#parts + 1] = sec .. "*" .. loot[sec].count end
	end
	return string.format("%d|%s|%s", id, status, table.concat(parts, ";"))
end

-- GAMMA's IsMonster() knows the client classes only (server mutants are
-- *_s); the engine's is_monster() is exact on both.
local function is_corpse(obj)
	return obj and not obj:alive() and (obj:is_monster() or obj:clsid() == clsid.crow)
end

local function loot_of(obj)
	return se_load_var(obj:id(), obj:name(), "netcoop_mutant_loot")
end

local function open(actor, obj)
	local id = obj:id()
	local loot = loot_of(obj)
	if not loot then
		if se_load_var(id, obj:name(), "looted") then
			return payload(id, "empty")
		end
		local st = db.storage[id]
		if st and st.death_time and game.get_game_time():diffSec(st.death_time) > decay_time() then
			return payload(id, "decayed")
		end
		loot = {}
		ui_mutant_loot.loot_mutant(obj:section(), obj:clsid(), loot, nil, true, obj)
		se_save_var(id, obj:name(), "netcoop_mutant_loot", loot)
	end
	if #sorted_sections(loot) == 0 then return payload(id, "empty") end
	return payload(id, "ok", loot)
end

-- counts: "all" or "n,n,n" in the order of the list the client was sent
local function take(actor, obj, counts)
	local id = obj:id()
	local loot = loot_of(obj)
	if not loot then return "nothing to take" end
	local order = sorted_sections(loot)
	local wanted = {}
	if counts == "all" then
		for _, sec in ipairs(order) do wanted[sec] = loot[sec].count end
	else
		local i = 0
		for n in string.gmatch(counts or "", "%d+") do
			i = i + 1
			local sec, count = order[i], tonumber(n)
			if not sec then return "the list changed" end
			if count > loot[sec].count then return "the list changed" end
			if count > 0 then wanted[sec] = count end
		end
		if i ~= #order then return "the list changed" end
	end
	local taken = 0
	for sec, count in pairs(wanted) do
		for _ = 1, count do
			if item_knife and item_knife.degradate then pcall(item_knife.degradate) end
			alife_create_item(sec, actor, ITEM_PROPS)
			taken = taken + 1
		end
		loot[sec].count = loot[sec].count - count
		if loot[sec].count <= 0 then loot[sec] = nil end
	end
	if taken == 0 then return "nothing selected" end
	local left = #sorted_sections(loot) > 0
	se_save_var(id, obj:name(), "looted", not left)
	if xr_corpse_detection and xr_corpse_detection.set_valuable_loot then xr_corpse_detection.set_valuable_loot(id, left) end
	netcoop_send_to_actor(actor:id(), "mutant_loot", payload(id, left and "ok" or "empty", left and loot or nil))
	return ""
end

-- netcoop_server_compat.item_action, kind 2 (db.actor is the player)
function action(actor, obj, request)
	if not (actor and is_corpse(obj)) then return "this is not a mutant body" end
	if request == "mloot_open" then
		netcoop_send_to_actor(actor:id(), "mutant_loot", open(actor, obj))
		return ""
	end
	local counts = string.match(request or "", "^mloot_take (.+)$")
	if counts then return take(actor, obj, counts) end
	return nil
end
