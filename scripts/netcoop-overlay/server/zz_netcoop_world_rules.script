-- Lost Zone population is finite. New-game fill_start_position owns initial
-- squads; smart terrain replenishment must never replace dead NPCs/mutants.
-- Do not intercept SIMBOARD:create_squad globally: quests and initial world
-- creation use that same entry point.
local blocked_methods = {}
local guarded_savers = {}
local guarded_cleaners = {}
local encoded_snapshot, encoded_name

local function cooperative()
    return netcoop_enabled and netcoop_enabled()
end

local function keep_inventory_from_purge(owner, name)
    local original = owner and owner[name]
    if type(original) ~= "function" or guarded_cleaners[original] then return end
    local guarded = function(...)
        if cooperative() then return end
        return original(...)
    end
    guarded_cleaners[guarded] = true
    owner[name] = guarded
end

-- Freeplay population, then no replenishment (owner 2026-10-05/06). In
-- freeplay a map's population (all its mutants, part of its stalkers) comes
-- from smart terrain respawn during the first game hours; blocking respawn
-- entirely left the maps without mutants. Each respawn section of a smart
-- may spawn as many squads, in total over the world's life, as its freeplay
-- limit; once it has, dead squads are not replaced.
local function spawned_totals(smart)
    local state = alife_storage_manager.get_state()
    state.netcoop_spawned = state.netcoop_spawned or {}
    state.netcoop_spawned[smart.id] = state.netcoop_spawned[smart.id] or {}
    return state.netcoop_spawned[smart.id]
end

local function section_limit(smart, params)
    local actor = db.actor or level.object_by_id(0)
    local ok, picked = pcall(xr_logic.pick_section_from_condlist, actor, smart, params.num)
    local value = ok and tonumber(picked) or 0
    return value > 0 and math.max(1, math.ceil(value)) or 0
end

-- No squad appears in front of a player: GAMMA measured the respawn radius
-- to db.actor only, the hidden anchor Actor on the dedicated server.
local function player_near(smart)
    local radius = smart.respawn_radius or 150
    local pos = smart.position
    if not pos then return false end
    for id in string.gmatch(netcoop_players and netcoop_players() or "", "%d+") do
        local obj = level.object_by_id(tonumber(id))
        if obj and obj:position():distance_to_sqr(pos) < radius * radius then return true end
    end
    return false
end

-- Cluster: this server's copy of another map is not its world (that map's
-- server owns it); spawning there only fills memory. Checked once per smart.
local cluster_file_present = nil
local smart_here = {}
local function on_this_map(smart)
    if cluster_file_present == nil then
        local path = getFS and getFS():update_path("$app_data_root$", "netcoop_cluster.ltx")
        local file = path and io.open(path, "r")
        if file then file:close() end
        cluster_file_present = file ~= nil
    end
    if not cluster_file_present then return true end
    local known = smart_here[smart.id]
    if known == nil then
        local gg, sim = game_graph(), alife()
        local vertex = gg and smart.m_game_vertex_id and gg:vertex(smart.m_game_vertex_id)
        known = not vertex or sim:level_name(vertex:level_id()) == level.name()
        smart_here[smart.id] = known
    end
    return known
end

local function respawn_once(original, smart, ...)
    if not (smart.respawn_params and smart.already_spawned) then return original(smart, ...) end
    if not on_this_map(smart) or player_near(smart) then return end
    local totals = spawned_totals(smart)
    local held, before = {}, {}
    for k, params in pairs(smart.respawn_params) do
        local current = smart.already_spawned[k]
        if current and current.num then
            before[k] = current.num
            -- This section filled once already: it looks full to GAMMA now.
            if (totals[k] or 0) >= section_limit(smart, params) then
                held[k] = current.num
                current.num = 1000000
            end
        end
    end
    local ok, err = pcall(original, smart, ...)
    for k, num in pairs(held) do smart.already_spawned[k].num = num end
    for k, num in pairs(before) do
        local now = smart.already_spawned[k] and smart.already_spawned[k].num
        if not held[k] and now and now > num then totals[k] = (totals[k] or 0) + (now - num) end
    end
    if not ok then error(err) end
end

function on_try_respawn(smart, flags)
end

-- Other mods add NPCs/mutants from nothing on a timer or on the Actor's
-- update: night mutants, base guard squads, bounty hunter squads. The
-- population is finite (owner 2026-10-05): these spawners stay off; quest
-- spawns (tasks_*, dialogs) are untouched.
local SPAWNERS = {
    {"night_mutants", "try_to_spawn", "actor_on_update"},
    {"guards_spawner", "spawn_guard", "actor_on_update"},
    {"sim_squad_bounty", "try_spawn", nil},
}
local disabled_spawners = {}
local guarded_bounty_timers = {}

local function retire_bounty_spawn_timer()
    local module = sim_squad_bounty
    local original = module and module.spawn_timer
    if type(original) == "function" and not guarded_bounty_timers[original] then
        local guarded = function(...)
            if cooperative() then return true end -- spawning is already disabled
            return original(...)
        end
        guarded_bounty_timers[guarded] = true
        module.spawn_timer = guarded
    end
    -- GAMMA can have captured the old function before our on_game_load hook.
    -- Keep the state/cleanup timer for bounty squads already in the world.
    if type(RemoveTimeEvent) == "function" then RemoveTimeEvent("cycle", "bounty_squad_spawn") end
end

local function disable_spawners()
    for _, entry in ipairs(SPAWNERS) do
        local module, name, callback = _G[entry[1]], entry[2], entry[3]
        local original = module and module[name]
        if type(original) == "function" and not disabled_spawners[original] then
            if callback and UnregisterScriptCallback then UnregisterScriptCallback(callback, original) end
            local off = function() end
            disabled_spawners[off] = true
            module[name] = off
            printf("[Lost Zone][world] spawner %s.%s disabled", entry[1], name)
        end
    end
end

-- Squads stay on the map they are on (doc 43 H11). A location server holds
-- players of its own map only; a squad walking off to another map would
-- leave it for good, unseen (the population is finite). Scripted targets
-- (quests, story squads) use their own path and still travel.
local guarded_targets = {}

local function same_level(a, b)
    local graph = game_graph and game_graph()
    if not (graph and a.m_game_vertex_id and b.m_game_vertex_id) then return true end
    return graph:vertex(a.m_game_vertex_id):level_id() == graph:vertex(b.m_game_vertex_id):level_id()
end

local function keep_squads_on_their_map()
    local classes = {
        smart_terrain and smart_terrain.se_smart_terrain,
        sim_squad_scripted and sim_squad_scripted.sim_squad_scripted,
    }
    for _, class in pairs(classes) do
        local original = class and class.target_precondition
        if type(original) == "function" and not guarded_targets[original] then
            local guarded = function(self, squad, ...)
                if cooperative() and squad and not same_level(self, squad) then return false end
                return original(self, squad, ...)
            end
            guarded_targets[guarded] = true
            class.target_precondition = guarded
        end
    end
end

-- Location cluster (doc 43 H11): every location server loads the ALife of the
-- whole Zone, but only its own map is ever seen. Generic squads of the other
-- maps are invisible copies here; the server of their map owns the real ones.
-- Once per world they are released, so each server simulates only its own
-- population and NPCs arriving from another map are not doubles. Story
-- squads, companions and squads on a scripted target stay.
local release_pending = false
local function cluster_mode()
    local path = getFS and getFS():update_path("$app_data_root$", "netcoop_cluster.ltx")
    local file = path and io.open(path, "r")
    if file then file:close() end
    return file ~= nil
end

function release_foreign_population()
    if not (cooperative() and cluster_mode() and SIMBOARD and SIMBOARD.squads and alife_storage_manager) then return 0 end
    local state = alife_storage_manager.get_state()
    if state.netcoop_foreign_released then return 0 end
    -- A new world gets its population on the first update: wait for it.
    if SIMBOARD.start_position_filled == false or next(SIMBOARD.squads) == nil then return nil end
    local here, graph, sim = level.name(), game_graph(), alife()
    local companions = axr_companions and axr_companions.companion_squads or {}
    local doomed = {}
    -- SIMBOARD.squads maps squad id -> true (sim_squad_scripted:on_register).
    for id in pairs(SIMBOARD.squads) do
        local squad = sim:object(id)
        local gv = squad and squad.m_game_vertex_id
        local level_name = gv and sim:level_name(graph:vertex(gv):level_id())
        if level_name and level_name ~= here and not (get_object_story_id and get_object_story_id(id))
            and not companions[id] and not (squad.get_script_target and squad:get_script_target()) then
            doomed[#doomed + 1] = squad
        end
    end
    local members = 0
    for _, squad in ipairs(doomed) do
        local ids = {}
        for member in squad:squad_members() do ids[#ids + 1] = member.id end
        for _, id in ipairs(ids) do
            if not (get_object_story_id and get_object_story_id(id)) then
                alife_release_id(id)
                members = members + 1
            end
        end
        alife_release(squad)
    end
    state.netcoop_foreign_released = true
    printf("[Lost Zone][world] released %s squad(s), %s NPC(s) of other maps: their location servers own them", #doomed, members)
    return #doomed
end

-- Online smart terrains are updated by their game object's binder
-- (bind_smart_terrain: se_smart_terrain:update) - which does not run on the
-- dedicated server: the map's own smarts never updated, so they never
-- respawned (no mutants at all) nor ran their per-update logic. Offline
-- ones are updated by ALife and were fine. Every second, the online smarts
-- of this map get their update here.
local next_smart_update = 0
local function update_online_smarts()
    if time_global() < next_smart_update then return false end
    next_smart_update = time_global() + 1000
    for _, smart in pairs(SIMBOARD and SIMBOARD.smarts or {}) do
        local s = smart.smrt
        if s and s.online and s.update then pcall(s.update, s) end
    end
    return false
end
local smart_updates_installed = false

function install()
    if not cooperative() then return end
    if not smart_updates_installed and AddUniqueCall then
        smart_updates_installed = true
        AddUniqueCall(update_online_smarts)
    end
    disable_spawners()
    retire_bounty_spawn_timer()
    keep_squads_on_their_map()
    if release_foreign_population() == nil and AddUniqueCall and not release_pending then
        release_pending = true
        local next_try = 0
        AddUniqueCall(function()
            if time_global() < next_try then return false end
            next_try = time_global() + 5000
            local done = release_foreign_population() ~= nil
            if done then release_pending = false end
            return done
        end)
    end
    -- These are inventory/artefact age purges, not AI consumption or trading.
    keep_inventory_from_purge(grok_artefact_despawner, "delete_artefacts")
    keep_inventory_from_purge(release_npc_inventory, "clean_npc_inv")
    -- This manager implements only the age-based dropped-item purge. Keep
    -- consumption, repairs, quest removal and explicit pickup paths intact.
    local cleaner = release_item_manager and release_item_manager.clear
    if type(cleaner) == "function" and not guarded_cleaners[cleaner] then
        local guarded = function(...)
            if cooperative() then return true end -- retire a queued purge timer
            return cleaner(...)
        end
        guarded_cleaners[guarded] = true
        release_item_manager.clear = guarded
    end
    -- on_game_load may have queued the old function before this late script
    -- installed the guard. Removing that particular timer closes that path.
    if type(RemoveTimeEvent) == "function" then RemoveTimeEvent(0, "release_item") end
    local class = smart_terrain and smart_terrain.se_smart_terrain
    if class and type(class.try_respawn) == "function" and not blocked_methods[class.try_respawn] then
        local original = class.try_respawn
        local guarded = function(self, ...)
            if cooperative() then return respawn_once(original, self, ...) end
            return original(self, ...)
        end
        blocked_methods[guarded] = true
        class.try_respawn = guarded
        printf("[Lost Zone][world] smart respawn fills each section to its freeplay limit once; dead squads are not replaced")
    end
    local storage = alife_storage_manager
    local saver = storage and storage.CALifeStorageManager_before_save
    if marshal and type(marshal.encode) == "function" and type(saver) == "function" and not guarded_savers[saver] then
        local guarded = function(fname)
            encoded_snapshot, encoded_name = nil, nil
            local encode = marshal.encode
            -- Capture the actual encoder output once. Encoding the state a
            -- second time could change userdata serializers or table order.
            marshal.encode = function(state)
                local data = encode(state)
                if state == storage.get_state() then
                    encoded_snapshot = data
                    encoded_name = fname:sub(0, -6):lower()
                end
                return data
            end
            local ok, err = pcall(saver, fname)
            marshal.encode = encode
            if not ok then
                encoded_snapshot, encoded_name = nil, nil
                printf("! [Lost Zone][world] script state save failed: %s", tostring(err))
                error(err)
            end
        end
        guarded_savers[guarded] = true
        storage.CALifeStorageManager_before_save = guarded
    end
end

function script_snapshot_matches(save)
    local expected = encoded_snapshot
    encoded_snapshot = nil -- release the buffer after validation, including failure
    if type(expected) ~= "string" or expected == "" or encoded_name ~= save:lower() then return false end
    local path = getFS():update_path("$game_saves$", "") .. encoded_name .. ".scoc"
    local file = io.open(path, "rb")
    if not file then return false end
    local actual = file:read("*all")
    local closed = file:close()
    return closed and actual == expected or false
end

function on_game_start()
    if not cooperative() then return end
    RegisterScriptCallback("on_try_respawn", on_try_respawn)
    RegisterScriptCallback("on_game_load", install)
    install()
end
