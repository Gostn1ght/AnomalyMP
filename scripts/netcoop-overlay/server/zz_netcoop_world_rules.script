-- Lost Zone population is finite. New-game fill_start_position owns initial
-- squads; smart terrain replenishment must never replace dead NPCs/mutants.
-- Do not intercept SIMBOARD:create_squad globally: quests and initial world
-- creation use that same entry point.
local blocked_methods = {}
local guarded_savers = {}
local guarded_cleaners = {}
local encoded_snapshot, encoded_name

local function cooperative()
    return netcoop_enabled and netcoop_enabled()
end

local function keep_inventory_from_purge(owner, name)
    local original = owner and owner[name]
    if type(original) ~= "function" or guarded_cleaners[original] then return end
    local guarded = function(...)
        if cooperative() then return end
        return original(...)
    end
    guarded_cleaners[guarded] = true
    owner[name] = guarded
end

function on_try_respawn(smart, flags)
    if cooperative() and flags then flags.disabled = true end
end

function install()
    if not cooperative() then return end
    -- These are inventory/artefact age purges, not AI consumption or trading.
    keep_inventory_from_purge(grok_artefact_despawner, "delete_artefacts")
    keep_inventory_from_purge(release_npc_inventory, "clean_npc_inv")
    -- This manager implements only the age-based dropped-item purge. Keep
    -- consumption, repairs, quest removal and explicit pickup paths intact.
    local cleaner = release_item_manager and release_item_manager.clear
    if type(cleaner) == "function" and not guarded_cleaners[cleaner] then
        local guarded = function(...)
            if cooperative() then return true end -- retire a queued purge timer
            return cleaner(...)
        end
        guarded_cleaners[guarded] = true
        release_item_manager.clear = guarded
    end
    -- on_game_load may have queued the old function before this late script
    -- installed the guard. Removing that particular timer closes that path.
    if type(RemoveTimeEvent) == "function" then RemoveTimeEvent(0, "release_item") end
    local class = smart_terrain and smart_terrain.se_smart_terrain
    if class and type(class.try_respawn) == "function" and not blocked_methods[class.try_respawn] then
        local original = class.try_respawn
        local guarded = function(self, ...)
            if cooperative() then return end
            return original(self, ...)
        end
        blocked_methods[guarded] = true
        class.try_respawn = guarded
        printf("[Lost Zone][world] NPC/mutant replenishment disabled; initial population and surviving squads preserved")
    end
    local storage = alife_storage_manager
    local saver = storage and storage.CALifeStorageManager_before_save
    if marshal and type(marshal.encode) == "function" and type(saver) == "function" and not guarded_savers[saver] then
        local guarded = function(fname)
            encoded_snapshot, encoded_name = nil, nil
            local encode = marshal.encode
            -- Capture the actual encoder output once. Encoding the state a
            -- second time could change userdata serializers or table order.
            marshal.encode = function(state)
                local data = encode(state)
                if state == storage.get_state() then
                    encoded_snapshot = data
                    encoded_name = fname:sub(0, -6):lower()
                end
                return data
            end
            local ok, err = pcall(saver, fname)
            marshal.encode = encode
            if not ok then
                encoded_snapshot, encoded_name = nil, nil
                error(err)
            end
        end
        guarded_savers[guarded] = true
        storage.CALifeStorageManager_before_save = guarded
    end
end

function script_snapshot_matches(save)
    local expected = encoded_snapshot
    encoded_snapshot = nil -- release the buffer after validation, including failure
    if type(expected) ~= "string" or expected == "" or encoded_name ~= save:lower() then return false end
    local path = getFS():update_path("$game_saves$", "") .. encoded_name .. ".scoc"
    local file = io.open(path, "rb")
    if not file then return false end
    local actual = file:read("*all")
    local closed = file:close()
    return closed and actual == expected or false
end

function on_game_start()
    if not cooperative() then return end
    RegisterScriptCallback("on_try_respawn", on_try_respawn)
    RegisterScriptCallback("on_game_load", install)
    install()
end
