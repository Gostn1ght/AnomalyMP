; Location cluster: one dedicated server per map (generated, then edit hosts).
; host = the address clients use for that map; a machine runs the maps whose
; host is its own (netcoop_cluster_watchdog.ps1). All machines share app data.
[cluster]
max_players = 512
per_server = 128

[locations]
jupiter = 127.0.0.1:1301
k00_marsh = 127.0.0.1:1267
k01_darkscape = 127.0.0.1:1303
k02_trucks_cemetery = 127.0.0.1:1305
l01_escape = 127.0.0.1:1277
l02_garbage = 127.0.0.1:1307
l03_agroprom = 127.0.0.1:1309
l04_darkvalley = 127.0.0.1:1311
l05_bar = 127.0.0.1:1313
l06_rostok = 127.0.0.1:1315
l07_military = 127.0.0.1:1317
l08_yantar = 127.0.0.1:1319
l09_deadcity = 127.0.0.1:1321
l10_limansk = 127.0.0.1:1323
l10_radar = 127.0.0.1:1325
l10_red_forest = 127.0.0.1:1327
l11_hospital = 127.0.0.1:1329
l11_pripyat = 127.0.0.1:1331
l12_stancia = 127.0.0.1:1333
l12_stancia_2 = 127.0.0.1:1335
pripyat = 127.0.0.1:1337
y04_pole = 127.0.0.1:1339
zaton = 127.0.0.1:1341

[launch]
; map = start location section (GAMMA or netcoop\start_levels.ltx)
jupiter = yanov_depo_monolith
k00_marsh = hidden_base
k01_darkscape = lz_k01_darkscape
k02_trucks_cemetery = tc_central_tower
